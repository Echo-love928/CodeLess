{
  "name": "@codeless/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src vite.config.ts vitest.config.ts playwright.config.ts playwright.real-auth.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm test && pnpm build",
    "smoke": "pnpm build && playwright test --config playwright.config.ts",
    "test:real-auth": "playwright test --config playwright.real-auth.config.ts"
  },
  "dependencies": {
    "element-plus": "2.9.7",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "@playwright/test": "1.60.0",
    "@types/node": "22.13.14",
    "@vitejs/plugin-vue": "5.2.3",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.23.0",
    "eslint-plugin-vue": "9.33.0",
    "jsdom": "26.0.0",
    "typescript": "5.8.2",
    "typescript-eslint": "8.27.0",
    "vite": "6.2.3",
    "vitest": "3.0.9",
    "vue-eslint-parser": "9.4.3",
    "vue-tsc": "2.2.8"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.16.0",
    "pnpm": "12.6.0"
  }
}
