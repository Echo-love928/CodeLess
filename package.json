{
  "name": "codeless",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.16.0",
    "pnpm": "12.6.0"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "verify:versions": "node scripts/verify-versions.mjs",
    "verify:contracts": "node scripts/validate-contracts.mjs all",
    "verify:static": "node scripts/run-static.mjs",
    "verify:api": "node scripts/run-maven.mjs",
    "verify:runner": "node scripts/validate-contracts.mjs runner",
    "verify:e2e": "node scripts/validate-contracts.mjs flow && pnpm --filter @codeless/web smoke",
    "ci:gate": "node scripts/ci-gate.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@redocly/cli": "2.54.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
