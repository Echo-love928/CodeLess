        "name": "files.create",
        "arguments": {
          "path": "src/components/ProfileCard.vue",
          "content": "<script setup lang=\"ts\">\ninterface WorkItem {\n  id: string;\n  title: string;\n  description: string;\n  year: string;\n}\n\ndefineProps<{\n  name: string;\n  role: string;\n  bio: string;\n  works: WorkItem[];\n}>();\n</script>\n\n<template>\n  <section class=\"profile-card\">\n    <header class=\"profile-card__header\">\n      <h1 class=\"profile-card__name\" data-testid=\"name\">{{ name }}</h1>\n      <p class=\"profile-card__role\" data-testid=\"role\">{{ role }}</p>\n    </header>\n    <p class=\"profile-card__bio\" data-testid=\"bio\">{{ bio }}</p>\n    <section class=\"profile-card__works\">\n      <h2 class=\"profile-card__works-title\" data-testid=\"works-title\">Works</h2>\n      <ul class=\"profile-card__list\" data-testid=\"works-list\">\n        <li\n          v-for=\"work in works\"\n          :key=\"work.id\"\n          class=\"profile-card__item\"\n          :data-testid=\"`work-${work.id}`\"\n        >\n          <h3 class=\"profile-card__item-title\">{{ work.title }}</h3>\n          <p class=\"profile-card__item-year\">{{ work.year }}</p>\n          <p class=\"profile-card__item-desc\">{{ work.description }}</p>\n        </li>\n      </ul>\n    </section>\n  </section>\n</template>\n\n<style scoped>\n.profile-card {\n  max-width: 40rem;\n  margin: 0 auto;\n  padding: 2rem;\n  border: 1px solid #e2e2e2;\n  border-radius: 12px;\n  font-family: Georgia, 'Times New Roman', serif;\n  color: #1f2933;\n  background: #ffffff;\n}\n\n.profile-card__name {\n  margin: 0;\n  font-size: 2.25rem;\n}\n\n.profile-card__role {\n  margin: 0.25rem 0 0;\n  color: #52606d;\n  font-size: 1rem;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.profile-card__bio {\n  margin: 1.25rem 0 0;\n  line-height: 1.6;\n}\n\n.profile-card__works {\n  margin-top: 2rem;\n}\n\n.profile-card__works-title {\n  margin: 0 0 0.75rem;\n  font-size: 1.25rem;\n  border-bottom: 2px solid #e2e2e2;\n  padding-bottom: 0.5rem;\n}\n\n.profile-card__list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: 1rem;\n}\n\n.profile-card__item {\n  padding: 1rem;\n  border-radius: 8px;\n  background: #f5f7fa;\n}\n\n.profile-card__item-title {\n  margin: 0;\n  font-size: 1.1rem;\n}\n\n.profile-card__item-year {\n  margin: 0.25rem 0 0;\n  font-size: 0.85rem;\n  color: #7b8794;\n}\n\n.profile-card__item-desc {\n  margin: 0.5rem 0 0;\n  line-height: 1.5;\n}\n</style>\n"
