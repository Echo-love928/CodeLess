  "invariants" : {
    "E1" : "task events are exactly 1..event_sequence",
    "E2" : "first event is STAGE_STARTED/PLAN",
    "E3" : "READY/FAILED has exactly one terminal event, last, matching status; FAILED has a code",
    "E4" : "terminal tasks are FINISHED and unleased; nonterminal tasks stay queued or running",
    "E5" : "stage changes follow PLAN->GENERATE->VERIFY->(REPAIR->GENERATE)*->READY|FAILED",
    "P1" : "ledger binding equals SQL row, version, build and artifact digest",
    "P2" : "SQL publication status agrees with the ledger phase",
    "P3" : "each publication reached hosting at most once, exactly when the ledger says PUBLISHING; no location overwritten",
    "P4" : "bytes served at the publication's own location hash to the bound digest and equal the frozen artifact",
    "P5" : "requester owns the application",
    "V1" : "VERIFIED has its own SUCCEEDED/exit 0 build and a frozen outcome with that build and artifact digest",
    "V2" : "FAILED never has a usable VERIFIED outcome and has its frozen FAILED report",
    "V3" : "DRAFT has no frozen outcome and no terminal source task",
    "V4" : "source task exists and belongs to the same application",
    "V5" : "READY task has exactly one VERIFIED version named by its READY event; others none",
    "V6" : "latest pointer is a VERIFIED version of the same application",
    "X1" : "served page carries only its owner's marker"
  }
}
