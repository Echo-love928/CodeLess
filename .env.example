# Local development values only. Copy to .env and replace before any shared deployment.
POSTGRES_DB=codeless
POSTGRES_USER=codeless
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_PORT=15432
CODELESS_DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/codeless
CODELESS_DATABASE_USER=codeless
CODELESS_DATABASE_PASSWORD=local-dev-only-change-me

CODELESS_PLATFORM_DOMAIN=platform.codeless.test
CODELESS_PREVIEW_DOMAIN=preview.codeless.test
CODELESS_PUBLICATION_DOMAIN=publish.codeless.test
CODELESS_PLATFORM_PORT=18080
CODELESS_PREVIEW_PORT=18081
CODELESS_PUBLICATION_PORT=18082
CODELESS_STORAGE_DIR=./.local-data

# Required by future authenticated platform integrations; never mounted into runner.
CODELESS_PLATFORM_SIGNING_KEY=
CODELESS_MODEL_API_KEY=
