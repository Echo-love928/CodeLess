      "arguments" : {
        "path" : "src/data/cafes.ts",
        "content" : "export interface Cafe {\n  id: string;\n  name: string;\n  district: string;\n  rating: number;\n  signatureDrink: string;\n  address: string;\n  hours: string;\n  description: string;\n}\n\nexport const districts: string[] = [\n  '静安区',\n  '黄浦区',\n  '徐汇区',\n  '杨浦区',\n  '长宁区',\n];\n\nexport const cafes: Cafe[] = [\n  {\n    id: 'cafe-1',\n    name: '晨光手冲工坊',\n    district: '静安区',\n    rating: 4.8,\n    signatureDrink: '耶加雪菲手冲',\n    address: '静安区南京西路 1024 号',\n    hours: '08:00 - 20:00',\n    description:\n      '藏在弄堂深处的精品咖啡馆，主打单一产地手冲，木质长吧台可以近距离观察咖啡师的冲泡手法。',\n  },\n  {\n    id: 'cafe-2',\n    name: '梧桐树咖啡馆',\n    district: '徐汇区',\n    rating: 4.6,\n    signatureDrink: '桂花拿铁',\n    address: '徐汇区武康路 88 号',\n    hours: '09:00 - 22:00',\n    description:\n      '老洋房改造的街角咖啡馆，秋日桂花拿铁是季节限定招牌，靠窗座位能看到整条梧桐街景。',\n  },\n  {\n    id: 'cafe-3',\n    name: '外滩烘焙社',\n    district: '黄浦区',\n    rating: 4.7,\n    signatureDrink: '冷萃气泡美式',\n    address: '黄浦区中山东一路 12 号',\n    hours: '07:30 - 21:00',\n    description:\n      '自家烘焙豆的咖啡馆，冷萃气泡美式清爽带果酸，二楼露台可以看见江边的老建筑群。',\n  },\n  {\n    id: 'cafe-4',\n    name: '大学路书咖',\n    district: '杨浦区',\n    rating: 4.5,\n    signatureDrink: '海盐焦糖拿铁',\n    address: '杨浦区大学路 56 号',\n    hours: '10:00 - 23:00',\n    description:\n      '书店与咖啡结合的空间，海盐焦糖拿铁甜咸平衡，晚上常有读书分享会与小型演出。',\n  },\n  {\n    id: 'cafe-5',\n    name: '弄堂小院咖啡',\n    district: '长宁区',\n    rating: 4.4,\n    signatureDrink: '柑橘气泡冷萃',\n    address: '长宁区愚园路 320 号',\n    hours: '09:30 - 19:30',\n    description:\n      '带小院子的社区咖啡馆，柑橘气泡冷萃酸甜解暑，院子里摆着几张藤椅，适合发呆一下午。',\n  },\n  {\n    id: 'cafe-6',\n    name: '静安寺咖啡实验室',\n    district: '静安区',\n    rating: 4.9,\n    signatureDrink: '氮气冷萃',\n    address: '静安区愚园路 8 号',\n    hours: '08:00 - 21:30',\n    description:\n      '以实验精神制作咖啡的小店，氮气冷萃口感绵密如丝绒，吧台还提供每周轮换的试验豆试饮。',\n  },\n];\n"
      }
