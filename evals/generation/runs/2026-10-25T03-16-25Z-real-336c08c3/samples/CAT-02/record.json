      "arguments" : {
        "path" : "src/components/CafeCard.vue",
        "content" : "<script setup lang=\"ts\">\nimport type { Cafe } from '../data/cafes';\n\ndefineProps<{\n  cafe: Cafe;\n  selected: boolean;\n}>();\n\nconst emit = defineEmits<{\n  (e: 'select', id: string): void;\n}>();\n</script>\n\n<template>\n  <article\n    data-ai-component=\"cafe-card\"\n    class=\"cafe-card\"\n    :class=\"{ 'cafe-card--selected': selected }\"\n    :data-testid=\"`card-${cafe.id}`\"\n    @click=\"emit('select', cafe.id)\"\n  >\n    <h3 class=\"cafe-card__name\">{{ cafe.name }}</h3>\n    <p class=\"cafe-card__district\">{{ cafe.district }}</p>\n    <p class=\"cafe-card__rating\">评分：{{ cafe.rating.toFixed(1) }}</p>\n    <p class=\"cafe-card__drink\">招牌饮品：{{ cafe.signatureDrink }}</p>\n  </article>\n</template>\n\n<style scoped>\n.cafe-card {\n  border: 1px solid #e2ddd4;\n  border-radius: 10px;\n  padding: 16px;\n  background: #fffdf9;\n  cursor: pointer;\n  transition: box-shadow 0.15s ease, border-color 0.15s ease;\n}\n\n.cafe-card:hover {\n  box-shadow: 0 4px 14px rgba(74, 52, 26, 0.12);\n}\n\n.cafe-card--selected {\n  border-color: #a2643a;\n  box-shadow: 0 0 0 2px rgba(162, 100, 58, 0.35);\n}\n\n.cafe-card__name {\n  margin: 0 0 8px;\n  font-size: 1.1rem;\n  color: #4a341a;\n}\n\n.cafe-card p {\n  margin: 4px 0;\n  color: #6b5b47;\n  font-size: 0.9rem;\n}\n</style>\n"
