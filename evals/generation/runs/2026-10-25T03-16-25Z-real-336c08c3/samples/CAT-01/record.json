      "arguments" : {
        "path" : "src/data/books.ts",
        "content" : "export type BookCategory = '小说' | '科技' | '历史';\n\nexport interface Book {\n  id: number;\n  title: string;\n  author: string;\n  category: BookCategory;\n  summary: string;\n}\n\nexport const categories: BookCategory[] = ['小说', '科技', '历史'];\n\nexport const books: Book[] = [\n  {\n    id: 1,\n    title: '百年孤独',\n    author: '加西亚·马尔克斯',\n    category: '小说',\n    summary: '布恩迪亚家族七代人的传奇故事，魔幻现实主义的经典之作。',\n  },\n  {\n    id: 2,\n    title: '活着',\n    author: '余华',\n    category: '小说',\n    summary: '讲述福贵历经苦难而依然坚韧活着的一生。',\n  },\n  {\n    id: 3,\n    title: '深入理解计算机系统',\n    author: 'Randal E. Bryant',\n    category: '科技',\n    summary: '从程序员视角讲解计算机系统的经典教材。',\n  },\n  {\n    id: 4,\n    title: '算法导论',\n    author: 'Thomas H. Cormen',\n    category: '科技',\n    summary: '全面介绍算法设计与分析的权威著作。',\n  },\n  {\n    id: 5,\n    title: '人类简史',\n    author: '尤瓦尔·赫拉利',\n    category: '历史',\n    summary: '从认知革命到科学革命，梳理人类发展的宏大脉络。',\n  },\n  {\n    id: 6,\n    title: '万历十五年',\n    author: '黄仁宇',\n    category: '历史',\n    summary: '以1587年为切入点，剖析明代社会的深层结构。',\n  },\n  {\n    id: 7,\n    title: '三体',\n    author: '刘慈欣',\n    category: '小说',\n    summary: '地球文明与三体文明相遇的科幻史诗。',\n  },\n  {\n    id: 8,\n    title: '时间简史',\n    author: '史蒂芬·霍金',\n    category: '科技',\n    summary: '面向大众讲述宇宙起源与黑洞奥秘的科普经典。',\n  },\n];\n"
      }
