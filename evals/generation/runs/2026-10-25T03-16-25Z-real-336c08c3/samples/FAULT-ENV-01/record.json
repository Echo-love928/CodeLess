      "name" : "files.create",
      "arguments" : {
        "path" : "src/pages/HomePage.vue",
        "content" : "<script setup lang=\"ts\">\nimport { ref } from 'vue';\n\ninterface SessionItem {\n  time: string;\n  title: string;\n}\n\nconst eventName: string = '2026 杭州前端开发者大会';\nconst eventDate: string = '2026年11月20日';\nconst eventVenue: string = '杭州国际博览中心';\n\nconst sessions: SessionItem[] = [\n  { time: '09:00', title: '开幕致辞' },\n  { time: '10:30', title: 'Vue 性能优化实战' },\n  { time: '14:00', title: '无障碍设计实践' },\n];\n\nconst registered = ref<boolean>(false);\n\nfunction handleRegister(): void {\n  registered.value = true;\n}\n</script>\n\n<template>\n  <main data-ai-component=\"home-page\" class=\"event-page\">\n    <h1 class=\"event-name\" data-testid=\"event-name\">{{ eventName }}</h1>\n    <p class=\"event-date\" data-testid=\"event-date\">日期：{{ eventDate }}</p>\n    <p class=\"event-venue\" data-testid=\"event-venue\">地点：{{ eventVenue }}</p>\n\n    <section class=\"schedule\">\n      <h2 class=\"schedule-title\">活动日程</h2>\n      <ul class=\"session-list\">\n        <li\n          v-for=\"(session, index) in sessions\"\n          :key=\"session.time\"\n          class=\"session-item\"\n          :data-testid=\"`session-${index}`\"\n        >\n          <span class=\"session-time\">{{ session.time }}</span>\n          <span class=\"session-name\">{{ session.title }}</span>\n        </li>\n      </ul>\n    </section>\n\n    <button type=\"button\" class=\"register-button\" data-testid=\"register-button\" @click=\"handleRegister\">\n      我要报名\n    </button>\n    <p v-if=\"registered\" class=\"register-notice\" data-testid=\"register-notice\">\n      报名意向已记录（演示）\n    </p>\n  </main>\n</template>\n\n<style scoped>\n.event-page {\n  max-width: 720px;\n  margin: 0 auto;\n  padding: 32px 24px;\n  font-family: 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;\n  color: #1f2933;\n}\n\n.event-name {\n  font-size: 28px;\n  margin: 0 0 16px;\n}\n\n.event-date,\n.event-venue {\n  margin: 4px 0;\n  font-size: 16px;\n  color: #52606d;\n}\n\n.schedule {\n  margin-top: 32px;\n}\n\n.schedule-title {\n  font-size: 20px;\n  margin: 0 0 12px;\n}\n\n.session-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.session-item {\n  display: flex;\n  gap: 16px;\n  padding: 12px 16px;\n  background: #f5f7fa;\n  border-radius: 8px;\n}\n\n.session-time {\n  font-weight: 600;\n  color: #2b6cb0;\n}\n\n.register-button {\n  margin-top: 32px;\n  padding: 10px 24px;\n  font-size: 16px;\n  color: #ffffff;\n  background: #2b6cb0;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n}\n\n.register-button:hover {\n  background: #23558a;\n}\n\n.register-notice {\n  margin-top: 12px;\n  color: #2f855a;\n  font-size: 15px;\n}\n</style>\n"
