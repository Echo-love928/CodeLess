    "files": {
      "src/components/ToolCard.vue": "<script setup lang=\"ts\">\nimport type { Tool } from '../data/tools';\n\ntype ToolCardProps = { tool: Tool };\n\ndefineProps<ToolCardProps>();\nconst emit = defineEmits<{ (e: 'select', id: string): void }>();\n\nfunction onSelect(id: string): void {\n  emit('select', id);\n}\n</script>\n\n<template>\n  <li class=\"tool-card\" data-ai-component=\"tool-card\">\n    <button class=\"tool-name\" type=\"button\" :data-testid=\"`tool-name-${tool.id}`\" @click=\"onSelect(tool.id)\">\n      {{ tool.name }}\n    </button>\n    <div class=\"meta\">\n      <span class=\"category\">类别：{{ tool.category }}</span>\n      <span class=\"license\">许可证：{{ tool.license }}</span>\n    </div>\n    <p class=\"summary\">{{ tool.summary }}</p>\n  </li>\n</template>\n\n<style scoped>\n.tool-card {\n  list-style: none;\n  border: 1px solid #d8dee9;\n  border-radius: 8px;\n  padding: 12px 14px;\n  background: #fff;\n}\n.tool-name {\n  background: none;\n  border: none;\n  padding: 0;\n  font-size: 17px;\n  font-weight: 600;\n  color: #1f6feb;\n  cursor: pointer;\n}\n.tool-name:hover {\n  text-decoration: underline;\n}\n.meta {\n  display: flex;\n  gap: 12px;\n  margin: 6px 0;\n  font-size: 13px;\n  color: #57606a;\n}\n.summary {\n  margin: 0;\n  font-size: 14px;\n  color: #24292f;\n}\n</style>\n",
      "src/components/ToolDetail.vue": "<script setup lang=\"ts\">\nimport type { Tool } from '../data/tools';\n\ntype ToolDetailProps = { tool: Tool };\n\ndefineProps<ToolDetailProps>();\nconst emit = defineEmits<{ (e: 'close'): void }>();\n</script>\n\n<template>\n  <section class=\"tool-detail\" data-ai-component=\"tool-detail\">\n    <h2 class=\"detail-name\" data-testid=\"detail-name\">{{ tool.name }}</h2>\n    <div class=\"meta\">\n      <span data-testid=\"detail-category\">类别：{{ tool.category }}</span>\n      <span data-testid=\"detail-license\">许可证：{{ tool.license }}</span>\n    </div>\n    <p class=\"summary\" data-testid=\"detail-summary\">{{ tool.summary }}</p>\n    <p class=\"detail-text\" data-testid=\"detail-text\">{{ tool.detail }}</p>\n    <button class=\"close\" type=\"button\" data-testid=\"detail-close\" @click=\"emit('close')\">关闭</button>\n  </section>\n</template>\n\n<style scoped>\n.tool-detail {\n  border: 1px solid #1f6feb;\n  border-radius: 8px;\n  padding: 14px 16px;\n  background: #f6f8fa;\n  margin-bottom: 16px;\n}\n.detail-name {\n  margin: 0 0 6px;\n  font-size: 20px;\n}\n.meta {\n  display: flex;\n  gap: 12px;\n  font-size: 13px;\n  color: #57606a;\n  margin-bottom: 6px;\n}\n.summary {\n  font-size: 14px;\n  font-weight: 600;\n  margin: 6px 0;\n}\n.detail-text {\n  font-size: 14px;\n  color: #24292f;\n  margin: 6px 0 10px;\n}\n.close {\n  padding: 4px 12px;\n  border: 1px solid #d0d7de;\n  border-radius: 6px;\n  background: #fff;\n  cursor: pointer;\n}\n</style>\n",
      "src/data/tools.ts": "export type ToolCategory = '构建' | '测试' | '文档';\n\nexport interface Tool {\n  id: string;\n  name: string;\n  category: ToolCategory;\n  license: string;\n  summary: string;\n  detail: string;\n}\n\nexport const tools: Tool[] = [\n  {\n    id: 'vite',\n    name: 'Vite',\n    category: '构建',\n    license: 'MIT',\n    summary: '下一代前端构建工具，提供极速的开发服务器与生产构建。',\n    detail: 'Vite 由 Vue 作者尤雨溪发起，利用浏览器原生 ES 模块实现闪电般的冷启动，并内置 Rollup 完成生产构建。',\n  },\n  {\n    id: 'rollup',\n    name: 'Rollup',\n    category: '构建',\n    license: 'MIT',\n    summary: '面向 ES 模块的 JavaScript 打包器，输出精简的构建产物。',\n    detail: 'Rollup 以 tree-shaking 著称，适合打包库与应用程序，是众多构建工具的核心依赖。',\n  },\n  {\n    id: 'esbuild',\n    name: 'esbuild',\n    category: '构建',\n    license: 'MIT',\n    summary: '用 Go 编写的极快 JavaScript 打包与压缩工具。',\n    detail: 'esbuild 通过并行编译与 Go 语言性能优势，将构建速度提升到传统工具的数倍，并支持 TypeScript 与 CSS。',\n  },\n  {\n    id: 'vitest',\n    name: 'Vitest',\n    category: '测试',\n    license: 'MIT',\n    summary: '由 Vite 驱动的单元测试框架，配置简单、运行迅速。',\n    detail: 'Vitest 提供与 Jest 兼容的 API，支持快照、覆盖率与并发测试，并与 Vite 的模块解析无缝集成。',\n  },\n  {\n    id: 'playwright',\n    name: 'Playwright',\n    category: '测试',\n    license: 'Apache-2.0',\n    summary: '跨浏览器的端到端测试框架，支持 Chromium、Firefox 与 WebKit。',\n    detail: 'Playwright 提供自动等待、追踪与并行执行能力，适合编写稳定的端到端测试。',\n  },\n  {\n    id: 'jest',\n    name: 'Jest',\n    category: '测试',\n    license: 'MIT',\n    summary: '流行的 JavaScript 测试框架，开箱即用无需额外配置。',\n    detail: 'Jest 内置断言、Mock 与覆盖率统计，广泛应用于 React、Node 等生态的单元测试。',\n  },\n  {\n    id: 'vitepress',\n    name: 'VitePress',\n    category: '文档',\n    license: 'MIT',\n    summary: '基于 Vite 与 Vue 的静态站点生成器，专注文档编写。',\n    detail: 'VitePress 支持 Markdown 内嵌 Vue 组件、快速热更新与主题定制，适合构建技术文档站点。',\n  },\n  {\n    id: 'docusaurus',\n    name: 'Docusaurus',\n    category: '文档',\n    license: 'MIT',\n    summary: '由 Meta 开源的文档站点框架，支持版本化与多语言。',\n    detail: 'Docusaurus 提供内置搜索、博客与版本管理能力，帮助团队快速搭建文档中心。',\n  },\n  {\n    id: 'typedoc',\n    name: 'TypeDoc',\n    category: '文档',\n    license: 'Apache-2.0',\n    summary: '从 TypeScript 源码注释自动生成 API 文档。',\n    detail: 'TypeDoc 解析 TypeScript 类型与 JSDoc 注释，输出风格一致的静态文档站点。',\n  },\n];\n",
      "src/pages/CatalogPage.vue": "<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\nimport ToolCard from '../components/ToolCard.vue';\nimport ToolDetail from '../components/ToolDetail.vue';\nimport { tools } from '../data/tools';\nimport type { Tool, ToolCategory } from '../data/tools';\n\nconst categories: ToolCategory[] = ['构建', '测试', '文档'];\nconst keyword = ref<string>('');\nconst category = ref<string>('全部');\nconst selectedId = ref<string>('');\n\nconst filtered = computed<Tool[]>(() => {\n  const kw = keyword.value.trim().toLowerCase();\n  return tools.filter((t) => {\n    const matchKw =\n      kw === '' ||\n      t.name.toLowerCase().includes(kw) ||\n      t.summary.toLowerCase().includes(kw);\n    const matchCat = category.value === '全部' || t.category === category.value;\n    return matchKw && matchCat;\n  });\n});\n\nconst selected = computed<Tool | null>(\n  () => tools.find((t) => t.id === selectedId.value) ?? null,\n);\n\nfunction onSelect(id: string): void {\n  selectedId.value = id;\n}\n\nfunction onClose(): void {\n  selectedId.value = '';\n}\n</script>\n\n<template>\n  <main class=\"catalog-page\" data-ai-component=\"catalog-page\">\n    <h1>开源工具目录</h1>\n    <div class=\"controls\">\n      <input\n        v-model=\"keyword\"\n        class=\"search\"\n        type=\"text\"\n        placeholder=\"搜索工具关键字\"\n        data-testid=\"search-input\"\n      />\n      <select v-model=\"category\" class=\"category-select\" data-testid=\"category-select\">\n        <option value=\"全部\">全部</option>\n        <option v-for=\"c in categories\" :key=\"c\" :value=\"c\">{{ c }}</option>\n      </select>\n    </div>\n\n    <ToolDetail v-if=\"selected\" :tool=\"selected\" @close=\"onClose\" />\n\n    <ul v-if=\"filtered.length > 0\" class=\"tool-list\">\n      <ToolCard v-for=\"t in filtered\" :key=\"t.id\" :tool=\"t\" @select=\"onSelect\" />\n    </ul>\n    <p v-else class=\"empty\" data-testid=\"empty-state\">没有匹配的工具</p>\n  </main>\n</template>\n\n<style scoped>\n.catalog-page {\n  max-width: 860px;\n  margin: 0 auto;\n  padding: 16px;\n  font-family: system-ui, sans-serif;\n}\nh1 {\n  font-size: 22px;\n  margin: 0 0 12px;\n}\n.controls {\n  display: flex;\n  gap: 10px;\n  margin-bottom: 16px;\n}\n.search {\n  flex: 1;\n  padding: 6px 10px;\n  border: 1px solid #d0d7de;\n  border-radius: 6px;\n}\n.category-select {\n  padding: 6px 10px;\n  border: 1px solid #d0d7de;\n  border-radius: 6px;\n}\n.tool-list {\n  display: grid;\n  gap: 10px;\n  margin: 0;\n  padding: 0;\n}\n.empty {\n  padding: 24px;\n  text-align: center;\n  color: #57606a;\n}\n</style>\n"
    },
    "digests": [
      {
        "path": "src/components/ToolCard.vue",
        "bytes": 1221,
        "digest": "sha256:99b72d716b78e26972d3482fc9abf68eee7a50d1979171cd3e41eeb53467f82b"
