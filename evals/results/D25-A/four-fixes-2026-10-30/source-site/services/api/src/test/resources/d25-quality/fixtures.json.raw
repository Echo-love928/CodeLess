    "files": {
      "src/components/CafeCard.vue": "<script setup lang=\"ts\">\nimport type { Cafe } from '../data/cafes';\n\ndefineProps<{ cafe: Cafe }>();\nconst emit = defineEmits<{ (e: 'select', id: number): void }>();\n</script>\n\n<template>\n  <article class=\"cafe-card\" data-ai-component=\"cafe-card\" @click=\"emit('select', cafe.id)\">\n    <h3 class=\"cafe-name\">{{ cafe.name }}</h3>\n    <p class=\"cafe-district\">{{ cafe.district }}</p>\n    <p class=\"cafe-rating\">评分：{{ cafe.rating }}</p>\n    <p class=\"cafe-signature\">招牌饮品：{{ cafe.signatureDrink }}</p>\n  </article>\n</template>\n\n<style scoped>\n.cafe-card {\n  border: 1px solid #e0e0e0;\n  border-radius: 8px;\n  padding: 12px;\n  cursor: pointer;\n  background: #fff;\n}\n.cafe-card:hover {\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);\n}\n.cafe-name {\n  margin: 0 0 8px;\n  font-size: 18px;\n}\n.cafe-card p {\n  margin: 4px 0;\n  font-size: 14px;\n  color: #555;\n}\n</style>\n",
      "src/components/CafeDetail.vue": "<script setup lang=\"ts\">\nimport type { Cafe } from '../data/cafes';\n\ndefineProps<{ cafe: Cafe | null }>();\n</script>\n\n<template>\n  <section class=\"cafe-detail\" data-ai-component=\"cafe-detail\">\n    <template v-if=\"cafe\">\n      <h2 class=\"detail-title\">{{ cafe.name }}</h2>\n      <p class=\"detail-line\">城区：{{ cafe.district }}</p>\n      <p class=\"detail-line\">评分：{{ cafe.rating }}</p>\n      <p class=\"detail-line\">招牌饮品：{{ cafe.signature }}</p>\n      <p class=\"detail-desc\">{{ cafe.description }}</p>\n    </template>\n    <p v-else class=\"detail-empty\">点击上方咖啡馆卡片查看详情</p>\n  </section>\n</template>\n\n<style scoped>\n.cafe-detail {\n  margin-top: 24px;\n  border: 1px solid #ddd;\n  border-radius: 8px;\n  padding: 16px;\n  background: #fafafa;\n}\n.detail-title {\n  margin: 0 0 8px;\n  font-size: 20px;\n}\n.detail-line {\n  margin: 4px 0;\n  font-size: 14px;\n  color: #444;\n}\n.detail-desc {\n  margin: 10px 0 0;\n  font-size: 14px;\n  color: #333;\n}\n.detail-empty {\n  margin: 0;\n  color: #888;\n}\n</style>\n",
      "src/data/cafes.ts": "export interface Cafe {\n  id: number;\n  name: string;\n  district: string;\n  rating: number;\n  signature: string;\n  description: string;\n}\n\nexport const cafes: Cafe[] = [\n  {\n    id: 1,\n    name: '云间咖啡',\n    district: '静安区',\n    rating: 4.8,\n    signature: '桂花拿铁',\n    description: '坐落于老弄堂中的安静小店，以手冲与桂花风味拿铁闻名，适合午后阅读。'\n  },\n  {\n    id: 2,\n    name: '梧桐树下',\n    district: '徐汇区',\n    rating: 4.6,\n    signature: '海盐焦糖玛奇朵',\n    description: '梧桐掩映的街角咖啡馆，主打海盐焦糖系列，露天座位深受附近居民喜爱。'\n  },\n  {\n    id: 3,\n    name: '外滩一号烘焙',\n    district: '黄浦区',\n    rating: 4.7,\n    signature: '燕麦冷萃',\n    description: '临近外滩的自烘焙工坊，每日现烘咖啡豆，燕麦冷萃清爽回甘。'\n  },\n  {\n    id: 4,\n    name: '长宁小院',\n    district: '长宁区',\n    rating: 4.5,\n    signature: '陈皮美式',\n    description: '带小院子的社区咖啡馆，陈皮美式独特清新，常有邻里猫咪光顾。'\n  },\n  {\n    id: 5,\n    name: '陆家嘴云端',\n    district: '浦东新区',\n    rating: 4.9,\n    signature: '氮气冷萃',\n    description: '高层写字楼中的现代咖啡馆，可俯瞰城市天际线，氮气冷萃口感绵密。'\n  },\n  {\n    id: 6,\n    name: '老北站咖啡',\n    district: '静安区',\n    rating: 4.3,\n    signature: '黑糖珍珠拿铁',\n    description: '怀旧风格的街边小店，黑糖珍珠拿铁甜而不腻，价格亲民。'\n  }\n];\n",
      "src/pages/CatalogPage.vue": "<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\nimport CafeCard from '../components/CafeCard.vue';\nimport CafeDetail from '../components/CafeDetail.vue';\nimport { cafes } from '../data/cafes';\nimport type { Cafe } from '../data/cafes';\n\nconst districts = computed<string[]>(() => {\n  const set: string[] = [];\n  for (const cafe of cafes) {\n    if (!set.includes(cafe.district)) {\n      set.push(cafe.district);\n    }\n  }\n  return set;\n});\n\nconst selectedDistrict = ref<string>('all');\nconst searchText = ref<string>('');\nconst selectedCafe = ref<Cafe | null>(null);\n\nconst filteredCafes = computed<Cafe[]>(() => {\n  const keyword = searchText.value.trim();\n  return cafes.filter((cafe) => {\n    const districtOk = selectedDistrict.value === 'all' || cafe.district === selectedDistrict.value;\n    const nameOk = keyword === '' || cafe.name.includes(keyword);\n    return districtOk && nameOk;\n  });\n});\n\nfunction selectCafe(id: number): void {\n  selectedCafe.value = cafes.find((cafe) => cafe.id === id) ?? null;\n}\n</script>\n\n<template>\n  <main class=\"catalog-page\" data-ai-component=\"catalog-page\">\n    <h1 class=\"page-title\">城市咖啡馆目录</h1>\n    <div class=\"filters\">\n      <label class=\"filter-label\" for=\"district-select\">城区筛选</label>\n      <select id=\"district-select\" v-model=\"selectedDistrict\" class=\"filter-select\" data-testid=\"district-select\">\n        <option value=\"all\">全部城区</option>\n        <option v-for=\"district in districts\" :key=\"district\" :value=\"district\">{{ district }}</option>\n      </select>\n      <label class=\"filter-label\" for=\"search-input\">按名称搜索</label>\n      <input id=\"search-input\" v-model=\"searchText\" type=\"text\" class=\"filter-input\" placeholder=\"输入咖啡馆名称\" data-testid=\"search-input\" />\n    </div>\n    <p class=\"result-count\" data-testid=\"result-count\">共 {{ filteredCafes.length }} 家咖啡馆</p>\n    <div class=\"cafe-list\">\n      <CafeCard\n        v-for=\"cafe in filteredCafes\"\n        :key=\"cafe.id\"\n        :cafe=\"cafe\"\n        @select=\"selectCafe\"\n      />\n    </div>\n    <p v-if=\"filteredCafes.length === 0\" class=\"empty-tip\" data-testid=\"empty-tip\">没有符合条件的咖啡馆</p>\n    <CafeDetail v-if=\"selectedCafe\" :cafe=\"selectedCafe\" />\n  </main>\n</template>\n\n<style scoped>\n.catalog-page {\n  max-width: 960px;\n  margin: 0 auto;\n  padding: 24px 16px;\n}\n.page-title {\n  margin: 0 0 16px;\n  font-size: 24px;\n}\n.filters {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px 12px;\n  margin-bottom: 12px;\n}\n.filter-label {\n  font-size: 14px;\n  color: #333;\n}\n.filter-select,\n.filter-input {\n  padding: 6px 8px;\n  border: 1px solid #ccc;\n  border-radius: 6px;\n  font-size: 14px;\n}\n.result-count {\n  margin: 0 0 12px;\n  font-size: 14px;\n  color: #666;\n}\n.cafe-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n  gap: 16px;\n}\n.empty-tip {\n  color: #999;\n}\n</style>\n"
    },
