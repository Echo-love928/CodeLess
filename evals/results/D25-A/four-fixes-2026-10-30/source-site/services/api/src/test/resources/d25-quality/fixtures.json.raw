  "books": {
    "batch": "2026-10-30T02-41-32Z-real-c3368088",
    "sample": "FAULT-CODE-03",
    "version": 2,
    "versionId": "67abe322-9ed8-492a-9eed-595be8abe53b",
    "recordDigest": "sha256:755f737ba43c5cb9b9d4b1fd44fea7e3139890b2acc7bc8a11ba113f8862863b",
    "sourceDigest": "sha256:ed78255c68ebefe961f8efe9d88911d9085aec8072803f9e44f079355d718cf4",
    "files": {
      "src/data/books.ts": "export type BookCategory = '小说' | '科技' | '历史';\n\nexport interface Book {\n  id: number;\n  title: string;\n  author: string;\n  category: BookCategory;\n  summary: string;\n}\n\nexport const books: Book[] = [\n  {\n    id: 1,\n    title: '三体',\n    author: '刘慈欣',\n    category: '小说',\n    summary: '人类文明与三体文明在宇宙中的生死博弈。'\n  },\n  {\n    id: 2,\n    title: '活着',\n    author: '余华',\n    category: '小说',\n    summary: '福贵一生坎坷，讲述苦难中生命的坚韧。'\n  },\n  {\n    id: 3,\n    title: '百年孤独',\n    author: '加西亚·马尔克斯',\n    category: '小说',\n    summary: '布恩迪亚家族七代人的传奇与孤独。'\n  },\n  {\n    id: 4,\n    title: '代码大全',\n    author: '史蒂夫·迈克康奈尔',\n    category: '科技',\n    summary: '软件构建实践的权威指南，覆盖编码与调试。'\n  },\n  {\n    id: 5,\n    title: '深入理解计算机系统',\n    author: 'Randal E. Bryant',\n    category: '科技',\n    summary: '从程序员视角剖析计算机系统的底层原理。'\n  },\n  {\n    id: 6,\n    title: '明朝那些事儿',\n    author: '当年明月',\n    category: '历史',\n    summary: '以通俗笔法讲述明朝三百年的兴衰故事。'\n  },\n  {\n    id: 7,\n    title: '万历十五年',\n    author: '黄仁宇',\n    category: '历史',\n    summary: '从一年切入，透视明代社会的深层结构。'\n  },\n  {\n    id: 8,\n    title: '人类简史',\n    author: '尤瓦尔·赫拉利',\n    category: '历史',\n    summary: '从认知革命到科学革命，梳理人类的演进。'\n  }\n];\n",
      "src/pages/CatalogPage.vue": "<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\nimport { books } from '../data/books';\nimport type { Book, BookCategory } from '../data/books';\n\ntype Filter = '全部' | BookCategory;\n\nconst query = ref<string>('');\nconst filter = ref<Filter>('全部');\nconst selected = ref<Book | null>(null);\n\nconst filters: Filter[] = ['全部', '小说', '科技', '历史'];\n\nconst filtered = computed<Book[]>(() => {\n  const q = query.value.trim();\n  return books.filter((b) => {\n    const matchQuery = q === '' || b.title.includes(q) || b.author.includes(q);\n    const matchFilter = filter.value === '全部' || b.category === filter.value;\n    return matchQuery && matchFilter;\n  });\n});\n\nfunction selectBook(b: Book): void {\n  selected.value = b;\n}\n</script>\n\n<template>\n  <main data-ai-component=\"catalog-page\" class=\"catalog\">\n    <h1 class=\"title\">图书目录</h1>\n\n    <div class=\"controls\">\n      <input\n        v-model=\"query\"\n        class=\"search\"\n        data-testid=\"search-input\"\n        type=\"text\"\n        placeholder=\"按书名或作者搜索\"\n      />\n      <div class=\"filters\">\n        <button\n          v-for=\"f in filters\"\n          :key=\"f\"\n          class=\"filter-btn\"\n          :class=\"{ active: filter === f }\"\n          type=\"button\"\n          @click=\"filter = f\"\n        >\n          {{ f }}\n        </button>\n      </div>\n    </div>\n\n    <p class=\"count\" data-testid=\"result-count\">\n      {{ filtered.length }} 本图书\n    </p>\n\n    <ul class=\"list\" data-testid=\"book-list\">\n      <li v-for=\"b in filtered\" :key=\"b.id\" class=\"book-card\">\n        <button class=\"book-btn\" type=\"button\" @click=\"selectBook(b)\">\n          <span class=\"book-title\">{{ b.title }}</span>\n          <span class=\"book-author\">{{ b.author }}</span>\n          <span class=\"book-cat\">{{ b.category }}</span>\n        </button>\n      </li>\n    </ul>\n\n    <p v-if=\"filtered.length === 0\" class=\"empty\" data-testid=\"empty\">\n      没有匹配的图书\n    </p>\n\n    <section v-if=\"selected\" class=\"detail\" data-testid=\"detail\">\n      <h2 class=\"detail-title\">{{ selected.title }}</h2>\n      <p class=\"detail-author\" data-testid=\"detail-author\">{{ selected.author }}</p>\n      <p class=\"detail-cat\" data-testid=\"detail-category\">{{ selected.category }}</p>\n      <p class=\"detail-summary\" data-testid=\"detail-summary\">{{ selected.summary }}</p>\n    </section>\n  </main>\n</template>\n\n<style scoped>\n.catalog {\n  max-width: 760px;\n  margin: 0 auto;\n  padding: 24px 16px;\n  font-family: system-ui, sans-serif;\n}\n.title {\n  font-size: 24px;\n  margin-bottom: 16px;\n}\n.controls {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-bottom: 12px;\n}\n.search {\n  padding: 8px 10px;\n  font-size: 14px;\n  border: 1px solid #ccc;\n  border-radius: 6px;\n}\n.filters {\n  display: flex;\n  gap: 8px;\n}\n.filter-btn {\n  padding: 6px 14px;\n  border: 1px solid #ccc;\n  border-radius: 999px;\n  background: #fff;\n  cursor: pointer;\n}\n.filter-btn.active {\n  background: #3459e6;\n  color: #fff;\n  border-color: #3459e6;\n}\n.count {\n  color: #666;\n  font-size: 13px;\n}\n.list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.book-btn {\n  width: 100%;\n  text-align: left;\n  padding: 12px;\n  border: 1px solid #e0e0e0;\n  border-radius: 8px;\n  background: #fafafa;\n  display: flex;\n  gap: 12px;\n  cursor: pointer;\n}\n.book-title {\n  font-weight: 600;\n}\n.book-author {\n  color: #555;\n}\n.book-cat {\n  margin-left: auto;\n  color: #3459e6;\n  font-size: 13px;\n}\n.empty {\n  color: #999;\n}\n.detail {\n  margin-top: 20px;\n  padding: 16px;\n  border: 1px solid #d5defa;\n  border-radius: 8px;\n  background: #f4f7ff;\n}\n.detail-title {\n  margin: 0 0 8px;\n  font-size: 20px;\n}\n.detail p {\n  margin: 4px 0;\n}\n</style>\n"
    },
