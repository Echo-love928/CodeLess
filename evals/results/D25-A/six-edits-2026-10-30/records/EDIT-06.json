           type=\"checkbox\"\n            :checked=\"task.done\"\n            :data-testid=\"'check-' + task.id\"\n            @change=\"toggleTask(task.id)\"\n          />\n          <span class=\"task-title\" :data-testid=\"'title-' + task.id\">{{ task.title }}</span>\n        </label>\n        <button\n          class=\"del-btn\"\n          type=\"button\"\n          :data-testid=\"'delete-' + task.id\"\n          @click=\"removeTask(task.id)\"\n        >\n          删除\n        </button>\n      </li>\n    </ul>\n  </main>\n</template>\n\n<style scoped>\n.tasks-page {\n  max-width: 520px;\n  margin: 0 auto;\n  padding: 24px;\n  font-family: system-ui, sans-serif;\n}\n.title {\n  font-size: 22px;\n  margin: 0 0 8px;\n}\n.count {\n  color: #555;\n  margin: 0 0 16px;\n}\n.add-row {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 16px;\n}\n.task-input {\n  flex: 1;\n  padding: 8px;\n  border: 1px solid #ccc;\n  border-radius: 4px;\n}\n.add-btn,\n.del-btn {\n  padding: 8px 14px;\n  border: 1px solid #ccc;\n  border-radius: 4px;\n  background: #f5f5f5;\n  cursor: pointer;\n}\n.task-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n.task-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 8px 0;\n  border-bottom: 1px solid #eee;\n}\n.task-label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n.task-item.done .task-title {\n  color: #999;\n  text-decoration: line-through;\n}\n.empty {\n  color: #999;\n}\n</style>\n"
