        "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue';\n\ninterface ScheduleItem {\n  time: string;\n  title: string;\n}\n\nconst eventName = '2026 杭州前端开发者大会';\nconst eventDate = '2026年11月20日';\nconst eventLocation = '杭州国际博览中心';\n\nconst schedule: ScheduleItem[] = [\n  { time: '09:00', title: '开幕致辞' },\n  { time: '10:30', title: 'Vue 性能优化实战' },\n  { time: '14:00', title: '无障碍设计实践' },\n];\n\nconst registered = ref<boolean>(false);\n\nfunction register(): void {\n  registered.value = true;\n}\n</script>\n\n<template>\n  <main data-ai-component=\"home-page\" class=\"event-page\">\n    <header class=\"hero\">\n      <h1 class=\"event-name\">{{ eventName }}</h1>\n      <p class=\"event-date\">{{ eventDate }}</p>\n      <p class=\"event-location\">{{ eventLocation }}</p>\n    </header>\n\n    <section class=\"schedule\">\n      <h2 class=\"schedule-title\">活动日程</h2>\n      <ul class=\"schedule-list\">\n        <li v-for=\"item in schedule\" :key=\"item.time\" class=\"schedule-item\">\n          <p class=\"schedule-item-text\">{{ item.time }} {{ item.title }}</p>\n        </li>\n      </ul>\n    </section>\n\n    <section class=\"signup\">\n      <button type=\"button\" class=\"signup-button\" @click=\"register\">立即报名</button>\n      <p v-if=\"registered\" class=\"signup-message\">报名意向已记录（演示）</p>\n    </section>\n  </main>\n</template>\n\n<style scoped>\n.event-page {\n  max-width: 720px;\n  margin: 0 auto;\n  padding: 2rem 1.5rem;\n  font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;\n  color: #1f2933;\n}\n\n.hero {\n  border-bottom: 2px solid #2563eb;\n  padding-bottom: 1.5rem;\n  margin-bottom: 2rem;\n}\n\n.event-name {\n  margin: 0 0 0.75rem;\n  font-size: 1.875rem;\n}\n\n.event-date,\n.event-location {\n  margin: 0.25rem 0;\n  color: #52606d;\n  font-size: 1.05rem;\n}\n\n.schedule-title {\n  font-size: 1.25rem;\n  margin: 0 0 1rem;\n}\n\n.schedule-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.schedule-item {\n  padding: 0.75rem 1rem;\n  border: 1px solid #e4e7eb;\n  border-radius: 8px;\n  margin-bottom: 0.75rem;\n  background: #f8fafc;\n}\n\n.schedule-item-text {\n  margin: 0;\n  font-weight: 600;\n}\n\n.signup {\n  margin-top: 2rem;\n}\n\n.signup-button {\n  padding: 0.7rem 1.6rem;\n  font-size: 1rem;\n  color: #ffffff;\n  background: #2563eb;\n  border: none;\n  border-radius: 8px;\n  cursor: pointer;\n}\n\n.signup-button:hover {\n  background: #1d4ed8;\n}\n\n.signup-message {\n  margin-top: 0.9rem;\n  color: #047857;\n  font-weight: 600;\n}\n</style>\n"
