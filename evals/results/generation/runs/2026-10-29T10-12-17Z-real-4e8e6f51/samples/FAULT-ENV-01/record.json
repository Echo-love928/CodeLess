      "arguments" : {
        "path" : "src/pages/HomePage.vue",
        "content" : "<template>\n  <main class=\"page\" data-ai-component=\"home-page\">\n    <header class=\"hero\">\n      <h1 class=\"title\">2026 杭州前端开发者大会</h1>\n      <p class=\"meta\">日期：2026年11月20日</p>\n      <p class=\"meta\">地点：杭州国际博览中心</p>\n    </header>\n\n    <section class=\"schedule\">\n      <h2 class=\"section-title\">活动日程</h2>\n      <ul class=\"list\">\n        <li v-for=\"item in schedule\" :key=\"item.time\" class=\"item\">\n          <span class=\"time\">{{ item.time }}</span>\n          <span class=\"name\">{{ item.title }}</span>\n        </li>\n      </ul>\n    </section>\n\n    <section class=\"signup\">\n      <button type=\"button\" class=\"btn\" @click=\"handleSignup\">我要报名</button>\n      <p v-if=\"registered\" class=\"notice\">报名意向已记录（演示）</p>\n    </section>\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nimport { ref } from 'vue';\n\ninterface ScheduleItem {\n  time: string;\n  title: string;\n}\n\nconst schedule: ScheduleItem[] = [\n  { time: '09:00', title: '开幕致辞' },\n  { time: '10:30', title: 'Vue 性能优化实战' },\n  { time: '14:00', title: '无障碍设计实践' }\n];\n\nconst registered = ref(false);\n\nfunction handleSignup(): void {\n  registered.value = true;\n}\n</script>\n\n<style scoped>\n.page {\n  max-width: 720px;\n  margin: 0 auto;\n  padding: 32px 20px 48px;\n  font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;\n  color: #1f2933;\n}\n\n.hero {\n  border-bottom: 1px solid #e4e7eb;\n  padding-bottom: 20px;\n  margin-bottom: 28px;\n}\n\n.title {\n  font-size: 28px;\n  margin: 0 0 12px;\n  color: #1a3d7c;\n}\n\n.meta {\n  margin: 4px 0;\n  font-size: 16px;\n  color: #52606d;\n}\n\n.section-title {\n  font-size: 20px;\n  margin: 0 0 12px;\n}\n\n.list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.item {\n  display: flex;\n  gap: 16px;\n  align-items: center;\n  padding: 12px 16px;\n  margin-bottom: 8px;\n  background: #f5f7fa;\n  border-radius: 8px;\n}\n\n.time {\n  font-weight: 600;\n  color: #1a3d7c;\n  min-width: 56px;\n}\n\n.name {\n  font-size: 16px;\n}\n\n.signup {\n  margin-top: 32px;\n}\n\n.btn {\n  padding: 10px 24px;\n  font-size: 16px;\n  color: #fff;\n  background: #1a3d7c;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n}\n\n.btn:hover {\n  background: #15316a;\n}\n\n.notice {\n  margin-top: 12px;\n  color: #0b7a3b;\n  font-size: 15px;\n}\n</style>\n"
