      "arguments" : {
        "path" : "src/pages/CatalogPage.vue",
        "content" : "<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\nimport { books } from '../data/books';\nimport type { Book, BookCategory } from '../data/books';\n\ntype FilterCategory = '全部' | BookCategory;\n\nconst categories: FilterCategory[] = ['全部', '小说', '科技', '历史'];\nconst keyword = ref('');\nconst activeCategory = ref<FilterCategory>('全部');\nconst selectedId = ref<number | null>(null);\n\nconst filteredBooks = computed<Book[]>(() => {\n  const kw = keyword.value.trim().toLowerCase();\n  return books.filter((book) => {\n    const matchCategory = activeCategory.value === '全部' || book.category === activeCategory.value;\n    const matchKeyword =\n      kw === '' || book.title.toLowerCase().includes(kw) || book.author.toLowerCase().includes(kw);\n    return matchCategory && matchKeyword;\n  });\n});\n\nconst selectedBook = computed<Book | null>(() =>\n  books.find((book) => book.id === selectedId.value) ?? null,\n);\n\nfunction selectCategory(category: FilterCategory): void {\n  activeCategory.value = category;\n}\n\nfunction selectBook(book: Book): void {\n  selectedId.value = book.id;\n}\n</script>\n\n<template>\n  <main data-ai-component=\"catalog-page\" class=\"catalog\">\n    <h1>图书目录</h1>\n    <section class=\"controls\">\n      <input\n        v-model=\"keyword\"\n        class=\"search\"\n        type=\"text\"\n        placeholder=\"搜索书名或作者\"\n        data-testid=\"search-input\"\n      />\n      <div class=\"filters\">\n        <button\n          v-for=\"category in categories\"\n          :key=\"category\"\n          type=\"button\"\n          class=\"filter-btn\"\n          :class=\"{ active: activeCategory === category }\"\n          :data-testid=\"'filter-' + category\"\n          @click=\"selectCategory(category)\"\n        >\n          {{ category }}\n        </button>\n      </div>\n    </section>\n\n    <section class=\"layout\">\n      <ul class=\"book-list\">\n        <li v-for=\"book in filteredBooks\" :key=\"book.id\">\n          <button\n            type=\"button\"\n            class=\"book-card\"\n            :class=\"{ selected: selectedId === book.id }\"\n            :data-testid=\"'book-' + book.id\"\n            @click=\"selectBook(book)\"\n          >\n            <h2 class=\"book-title\">{{ book.title }}</h2>\n            <p class=\"book-author\">{{ book.author }}</p>\n            <span class=\"book-tag\">{{ book.category }}</span>\n          </button>\n        </li>\n      </ul>\n\n      <aside class=\"detail\">\n        <h2 class=\"detail-heading\">图书详情</h2>\n        <div v-if=\"selectedBook\" class=\"detail-body\">\n          <h3 class=\"detail-title\">{{ selectedBook.title }}</h3>\n          <p class=\"detail-author\">作者：{{ selectedBook.author }}</p>\n          <p class=\"detail-category\">分类：{{ selectedBook.category }}</p>\n          <p class=\"detail-summary\">{{ selectedBook.summary }}</p>\n        </div>\n        <p v-else class=\"detail-empty\">请点击一本书查看详情。</p>\n      </aside>\n    </section>\n  </main>\n</template>\n\n<style scoped>\n.catalog {\n  max-width: 1000px;\n  margin: 0 auto;\n  padding: 24px 16px;\n  font-family: system-ui, sans-serif;\n  color: #1f2933;\n}\n.controls {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-bottom: 20px;\n}\n.search {\n  flex: 1 1 240px;\n  padding: 8px 12px;\n  border: 1px solid #cbd2d9;\n  border-radius: 6px;\n  font-size: 14px;\n}\n.filters {\n  display: flex;\n  gap: 8px;\n}\n.filter-btn {\n  padding: 8px 14px;\n  border: 1px solid #cbd2d9;\n  border-radius: 6px;\n  background: #fff;\n  cursor: pointer;\n  font-size: 14px;\n}\n.filter-btn.active {\n  background: #2563eb;\n  border-color: #2563eb;\n  color: #fff;\n}\n.layout {\n  display: flex;\n  gap: 24px;\n  align-items: flex-start;\n}\n.book-list {\n  flex: 1 1 60%;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));\n  gap: 12px;\n}\n.book-card {\n  width: 100%;\n  text-align: left;\n  padding: 12px;\n  border: 1px solid #cbd2d9;\n  border-radius: 8px;\n  background: #fff;\n  cursor: pointer;\n}\n.book-card.selected {\n  border-color: #2563eb;\n  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.25);\n}\n.book-title {\n  margin: 0 0 6px;\n  font-size: 16px;\n}\n.book-author {\n  margin: 0 0 8px;\n  font-size: 13px;\n  color: #52606d;\n}\n.book-tag {\n  display: inline-block;\n  padding: 2px 8px;\n  border-radius: 10px;\n  background: #e4e7eb;\n  font-size: 12px;\n}\n.detail {\n  flex: 0 0 32%;\n  padding: 16px;\n  border: 1px solid #cbd2d9;\n  border-radius: 8px;\n  background: #f8fafc;\n}\n.detail-heading {\n  margin: 0 0 12px;\n  font-size: 16px;\n}\n.detail-title {\n  margin: 0 0 8px;\n  font-size: 18px;\n}\n.detail-author,\n.detail-category {\n  margin: 0 0 6px;\n  font-size: 13px;\n  color: #52606d;\n}\n.detail-summary {\n  margin: 10px 0 0;\n  font-size: 14px;\n  line-height: 1.6;\n}\n.detail-empty {\n  margin: 0;\n  font-size: 14px;\n  color: #7b8794;\n}\n</style>\n"
      }
