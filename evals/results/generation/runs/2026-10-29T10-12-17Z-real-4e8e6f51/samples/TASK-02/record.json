        "content" : "export type ColumnId = 'todo' | 'doing' | 'done';\n\nexport interface Task {\n  id: string;\n  title: string;\n  column: ColumnId;\n}\n\nexport interface ColumnDef {\n  id: ColumnId;\n  label: string;\n}\n\nexport const COLUMNS: ColumnDef[] = [\n  { id: 'todo', label: '待开始' },\n  { id: 'doing', label: '进行中' },\n  { id: 'done', label: '已完成' }\n];\n\nexport const STORAGE_KEY = 'learn-board-tasks';\n\nexport const INITIAL_TASKS: Task[] = [\n  { id: 'seed-1', title: '整理本周学习笔记', column: 'todo' },\n  { id: 'seed-2', title: '阅读第三章', column: 'doing' },\n  { id: 'seed-3', title: '完成基础练习', column: 'done' }\n];\n\nexport function nextColumn(column: ColumnId): ColumnId | null {\n  if (column === 'todo') return 'doing';\n  if (column === 'doing') return 'done';\n  return null;\n}\n\nexport function loadTasks(): Task[] {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (!raw) return INITIAL_TASKS.slice();\n    const parsed = JSON.parse(raw) as unknown;\n    if (!Array.isArray(parsed)) return INITIAL_TASKS.slice();\n    const valid: Task[] = [];\n    for (const item of parsed as Task[]) {\n      if (\n        item &&\n        typeof item.id === 'string' &&\n        typeof item.title === 'string' &&\n        (item.column === 'todo' || item.column === 'doing' || item.column === 'done')\n      ) {\n        valid.push({ id: item.id, title: item.title, column: item.column });\n      }\n    }\n    return valid;\n  } catch {\n    return INITIAL_TASKS.slice();\n  }\n}\n\nexport function saveTasks(tasks: Task[]): void {\n  try {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks));\n  } catch {\n    // ignore quota errors\n  }\n}\n"
