      "name" : "files.create",
      "arguments" : {
        "path" : "src/pages/TasksPage.vue",
        "content" : "<script setup lang=\"ts\">\nimport { ref, computed } from 'vue';\nimport {\n  COLUMNS,\n  loadTasks,\n  saveTasks,\n  nextColumn,\n  type Task,\n  type ColumnId\n} from '../data/taskBoard';\n\nconst tasks = ref<Task[]>(loadTasks());\nconst draft = ref('');\nlet seq = 0;\n\nfunction persist(list: Task[]): void {\n  tasks.value = list;\n  saveTasks(list);\n}\n\nfunction addTask(): void {\n  const title = draft.value.trim();\n  if (!title) return;\n  seq += 1;\n  const task: Task = {\n    id: `task-${Date.now()}-${seq}`,\n    title,\n    column: 'todo'\n  };\n  persist([...tasks.value, task]);\n  draft.value = '';\n}\n\nfunction advance(task: Task): void {\n  const target = nextColumn(task.column);\n  if (!target) return;\n  persist(tasks.value.map((t) => (t.id === task.id ? { ...t, column: target } : t)));\n}\n\nfunction remove(task: Task): void {\n  persist(tasks.value.filter((t) => t.id !== task.id));\n}\n\nfunction tasksIn(column: ColumnId): Task[] {\n  return tasks.value.filter((t) => t.column === column);\n}\n\nconst counts = computed<Record<ColumnId, number>>(() => ({\n  todo: tasksIn('todo').length,\n  doing: tasksIn('doing').length,\n  done: tasksIn('done').length\n}));\n</script>\n\n<template>\n  <main data-ai-component=\"tasks-page\" class=\"board\">\n    <header class=\"board-head\">\n      <h1 class=\"board-title\">学习计划看板</h1>\n      <form class=\"add-form\" @submit.prevent=\"addTask\">\n        <input\n          v-model=\"draft\"\n          class=\"add-input\"\n          data-testid=\"new-task-input\"\n          type=\"text\"\n          placeholder=\"输入任务标题\"\n        />\n        <button class=\"add-btn\" data-testid=\"add-task\" type=\"submit\">新建任务</button>\n      </form>\n    </header>\n\n    <section class=\"columns\">\n      <article v-for=\"col in COLUMNS\" :key=\"col.id\" class=\"column\">\n        <h2 class=\"column-title\" :data-testid=\"`column-${col.id}`\">\n          {{ col.label }}（{{ counts[col.id] }}）\n        </h2>\n        <ul class=\"task-list\" :data-testid=\"`list-${col.id}`\">\n          <li v-for=\"task in tasksIn(col.id)\" :key=\"task.id\" class=\"task\">\n            <span class=\"task-title\" :data-testid=\"`title-${task.id}`\">{{ task.title }}</span>\n            <div class=\"task-actions\">\n              <button\n                v-if=\"col.id !== 'done'\"\n                class=\"action next\"\n                :data-testid=\"`next-${task.id}`\"\n                type=\"button\"\n                @click=\"advance(task)\"\n              >\n                下一步\n              </button>\n              <button\n                class=\"action del\"\n                :data-testid=\"`delete-${task.id}`\"\n                type=\"button\"\n                @click=\"remove(task)\"\n              >\n                删除\n              </button>\n            </div>\n          </li>\n          <li v-if=\"tasksIn(col.id).length === 0\" class=\"empty\">暂无任务</li>\n        </ul>\n      </article>\n    </section>\n    <p data-testid=\"task-total\" class=\"total\">任务总数：{{ tasks.length }}</p>\n  </main>\n</template>\n\n<style scoped>\n.board {\n  max-width: 960px;\n  margin: 0 auto;\n  padding: 24px 16px 48px;\n  font-family: system-ui, sans-serif;\n  color: #1f2933;\n}\n.board-title {\n  font-size: 24px;\n  margin: 0 0 16px;\n}\n.add-form {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 24px;\n}\n.add-input {\n  flex: 1;\n  padding: 8px 10px;\n  border: 1px solid #cbd2d9;\n  border-radius: 6px;\n  font-size: 14px;\n}\n.add-btn {\n  padding: 8px 16px;\n  border: none;\n  border-radius: 6px;\n  background: #2563eb;\n  color: #fff;\n  font-size: 14px;\n  cursor: pointer;\n}\n.columns {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 16px;\n}\n.column {\n  background: #f5f7fa;\n  border-radius: 10px;\n  padding: 12px;\n}\n.column-title {\n  font-size: 15px;\n  margin: 0 0 12px;\n}\n.task-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n.task {\n  background: #fff;\n  border-radius: 8px;\n  padding: 10px;\n  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.1);\n}\n.task-title {\n  display: block;\n  font-size: 14px;\n  margin-bottom: 8px;\n  word-break: break-word;\n}\n.task-actions {\n  display: flex;\n  gap: 8px;\n}\n.action {\n  border: 1px solid #cbd2d9;\n  background: #fff;\n  border-radius: 6px;\n  padding: 4px 10px;\n  font-size: 12px;\n  cursor: pointer;\n}\n.action.next {\n  border-color: #2563eb;\n  color: #2563eb;\n}\n.action.del {\n  border-color: #dc2626;\n  color: #dc2626;\n}\n.empty {\n  font-size: 12px;\n  color: #9aa5b1;\n}\n.total {\n  margin-top: 20px;\n  font-size: 13px;\n  color: #616e7c;\n}\n@media (max-width: 700px) {\n  .columns {\n    grid-template-columns: 1fr;\n  }\n}\n</style>\n"
      }
    }
