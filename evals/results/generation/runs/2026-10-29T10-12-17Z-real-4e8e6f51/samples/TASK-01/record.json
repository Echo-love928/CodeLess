      "arguments" : {
        "path" : "src/pages/TasksPage.vue",
        "content" : "<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\nimport { loadTasks, saveTasks, type Task } from '../data/tasks';\n\nconst tasks = ref<Task[]>(loadTasks());\nconst newTitle = ref<string>('');\n\nconst remaining = computed<number>(() => tasks.value.filter((t) => !t.done).length);\n\nfunction persist(): void {\n  saveTasks(tasks.value);\n}\n\nfunction addTask(): void {\n  const title = newTitle.value.trim();\n  if (!title) return;\n  tasks.value.push({ id: String(Date.now()) + '-' + String(Math.random()).slice(2, 8), title, done: false });\n  newTitle.value = '';\n  persist();\n}\n\nfunction toggleTask(id: string): void {\n  const task = tasks.value.find((t) => t.id === id);\n  if (!task) return;\n  task.done = !task.done;\n  persist();\n}\n\nfunction removeTask(id: string): void {\n  tasks.value = tasks.value.filter((t) => t.id !== id);\n  persist();\n}\n</script>\n\n<template>\n  <main data-ai-component=\"tasks-page\" class=\"tasks-page\">\n    <h1 class=\"title\">个人待办清单</h1>\n    <div class=\"add-row\">\n      <input\n        v-model=\"newTitle\"\n        class=\"task-input\"\n        data-testid=\"task-input\"\n        type=\"text\"\n        placeholder=\"输入任务标题\"\n        @keyup.enter=\"addTask\"\n      />\n      <button class=\"add-btn\" data-testid=\"add-btn\" type=\"button\" @click=\"addTask\">添加</button>\n    </div>\n    <p class=\"remaining\" data-testid=\"remaining\">未完成：{{ remaining }}</p>\n    <ul v-if=\"tasks.length > 0\" class=\"task-list\" data-testid=\"task-list\">\n      <li\n        v-for=\"task in tasks\"\n        :key=\"task.id\"\n        class=\"task-item\"\n        :class=\"{ done: task.done }\"\n        :data-testid=\"'task-item-' + task.id\"\n      >\n        <input\n          class=\"task-check\"\n          type=\"checkbox\"\n          :checked=\"task.done\"\n          :data-testid=\"'task-check-' + task.id\"\n          @change=\"toggleTask(task.id)\"\n        />\n        <span class=\"task-title\" :data-testid=\"'task-title-' + task.id\">{{ task.title }}</span>\n        <button\n          class=\"del-btn\"\n          type=\"button\"\n          :data-testid=\"'task-del-' + task.id\"\n          @click=\"removeTask(task.id)\"\n        >删除</button>\n      </li>\n    </ul>\n    <p v-else class=\"empty\" data-testid=\"empty\">暂无任务</p>\n  </main>\n</template>\n\n<style scoped>\n.tasks-page {\n  max-width: 520px;\n  margin: 0 auto;\n  padding: 24px 16px;\n  font-family: system-ui, sans-serif;\n  color: #1f2937;\n}\n.title {\n  font-size: 22px;\n  margin: 0 0 16px;\n}\n.add-row {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 12px;\n}\n.task-input {\n  flex: 1;\n  padding: 8px 10px;\n  border: 1px solid #d1d5db;\n  border-radius: 6px;\n  font-size: 14px;\n}\n.add-btn,\n.del-btn {\n  padding: 8px 14px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 14px;\n}\n.add-btn {\n  background: #2563eb;\n  color: #fff;\n}\n.del-btn {\n  background: #fee2e2;\n  color: #b91c1c;\n}\n.remaining {\n  font-size: 14px;\n  color: #4b5563;\n  margin: 0 0 12px;\n}\n.task-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n.task-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 12px;\n  border: 1px solid #e5e7eb;\n  border-radius: 8px;\n  margin-bottom: 8px;\n}\n.task-title {\n  flex: 1;\n  font-size: 15px;\n}\n.task-item.done .task-title {\n  text-decoration: line-through;\n  color: #9ca3af;\n}\n.empty {\n  color: #9ca3af;\n  font-size: 14px;\n}\n</style>\n"
