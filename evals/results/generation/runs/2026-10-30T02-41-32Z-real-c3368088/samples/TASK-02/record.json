    "payload" : {
      "type" : "tool",
      "name" : "files.create",
      "arguments" : {
        "path" : "src/data/tasks.ts",
        "content" : "export type ColumnId = 'todo' | 'doing' | 'done';\n\nexport interface Task {\n  id: number;\n  title: string;\n  column: ColumnId;\n}\n\nexport interface ColumnDef {\n  id: ColumnId;\n  label: string;\n}\n\nexport const COLUMNS: ColumnDef[] = [\n  { id: 'todo', label: '待开始' },\n  { id: 'doing', label: '进行中' },\n  { id: 'done', label: '已完成' }\n];\n\nexport const STORAGE_KEY = 'study-plan-board-tasks';\n\nexport function nextColumn(column: ColumnId): ColumnId | null {\n  const index = COLUMNS.findIndex((c) => c.id === column);\n  const target = COLUMNS[index + 1];\n  return target ? target.id : null;\n}\n\nexport function loadTasks(): Task[] {\n  try {\n    const raw = localStorage.getItem(STORAGE_KEY);\n    if (!raw) {\n      return [];\n    }\n    const parsed: unknown = JSON.parse(raw);\n    if (!Array.isArray(parsed)) {\n      return [];\n    }\n    const result: Task[] = [];\n    for (const item of parsed) {\n      if (item && typeof item === 'object') {\n        const record = item as Record<string, unknown>;\n        const id = typeof record.id === 'number' ? record.id : Number(record.id);\n        const title = typeof record.title === 'string' ? record.title : '';\n        const column = record.column;\n        if (\n          Number.isFinite(id) &&\n          title !== '' &&\n          (column === 'todo' || column === 'doing' || column === 'done')\n        ) {\n          result.push({ id, title, column });\n        }\n      }\n    }\n    return result;\n  } catch {\n    return [];\n  }\n}\n\nexport function saveTasks(tasks: Task[]): void {\n  try {\n    localStorage.setItem(STORAGE_KEY, JSON.stringify(tasks));\n  } catch {\n    // ignore storage failures\n  }\n}\n"
      }
    },
