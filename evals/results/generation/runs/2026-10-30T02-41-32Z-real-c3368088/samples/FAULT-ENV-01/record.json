      "arguments" : {
        "path" : "src/pages/HomePage.vue",
        "content" : "<script setup lang=\"ts\">\nimport { ref } from 'vue';\nimport { eventInfo } from '../data/event';\nimport type { ScheduleItem } from '../data/event';\n\nconst registered = ref(false);\nconst schedule: ScheduleItem[] = eventInfo.schedule;\n</script>\n\n<template>\n  <main data-ai-component=\"home-page\" class=\"page\">\n    <h1 class=\"title\">{{ eventInfo.name }}</h1>\n    <p class=\"meta\" data-testid=\"event-date\">日期：{{ eventInfo.date }}</p>\n    <p class=\"meta\" data-testid=\"event-location\">地点：{{ eventInfo.location }}</p>\n\n    <h2 class=\"subtitle\">活动日程</h2>\n    <ul class=\"schedule\">\n      <li v-for=\"item in schedule\" :key=\"item.time\" class=\"item\">\n        <span class=\"time\">{{ item.time }}</span>\n        <span class=\"item-title\">{{ item.title }}</span>\n      </li>\n    </ul>\n\n    <button type=\"button\" class=\"register\" data-testid=\"register-button\" @click=\"registered = true\">\n      我要报名\n    </button>\n    <p v-if=\"registered\" class=\"feedback\" data-testid=\"register-feedback\">报名意向已记录（演示）</p>\n  </main>\n</template>\n\n<style scoped>\n.page {\n  max-width: 640px;\n  margin: 0 auto;\n  padding: 32px 20px 48px;\n  font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;\n  color: #1f2937;\n}\n\n.title {\n  font-size: 26px;\n  margin: 0 0 16px;\n}\n\n.meta {\n  margin: 4px 0;\n  color: #4b5563;\n}\n\n.subtitle {\n  font-size: 18px;\n  margin: 28px 0 12px;\n}\n\n.schedule {\n  list-style: none;\n  margin: 0 0 28px;\n  padding: 0;\n}\n\n.item {\n  display: flex;\n  gap: 16px;\n  padding: 12px 16px;\n  border: 1px solid #e5e7eb;\n  border-radius: 8px;\n  margin-bottom: 10px;\n  background: #f9fafb;\n}\n\n.time {\n  font-weight: 600;\n  color: #2563eb;\n  min-width: 56px;\n}\n\n.register {\n  padding: 12px 28px;\n  font-size: 16px;\n  color: #ffffff;\n  background: #2563eb;\n  border: none;\n  border-radius: 8px;\n  cursor: pointer;\n}\n\n.register:hover {\n  background: #1d4ed8;\n}\n\n.feedback {\n  margin-top: 14px;\n  color: #15803d;\n  font-weight: 600;\n}\n</style>\n"
      }
