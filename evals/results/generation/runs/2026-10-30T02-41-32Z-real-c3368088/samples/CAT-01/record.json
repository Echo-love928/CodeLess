      "arguments" : {
        "path" : "src/data/books.ts",
        "content" : "export type Category = '小说' | '科技' | '历史';\n\nexport interface Book {\n  id: number;\n  title: string;\n  author: string;\n  category: Category;\n  summary: string;\n}\n\nexport const categories: Category[] = ['小说', '科技', '历史'];\n\nexport const books: Book[] = [\n  {\n    id: 1,\n    title: '红楼梦',\n    author: '曹雪芹',\n    category: '小说',\n    summary: '贾府兴衰间，宝黛悲欢映照人间冷暖。',\n  },\n  {\n    id: 2,\n    title: '活着',\n    author: '余华',\n    category: '小说',\n    summary: '福贵历经苦难，仍以坚韧面对生活。',\n  },\n  {\n    id: 3,\n    title: '三体',\n    author: '刘慈欣',\n    category: '小说',\n    summary: '人类文明与三体文明的宏大宇宙博弈。',\n  },\n  {\n    id: 4,\n    title: '代码大全',\n    author: '史蒂夫·麦康奈尔',\n    category: '科技',\n    summary: '系统讲解软件构建实践与工程方法。',\n  },\n  {\n    id: 5,\n    title: '算法导论',\n    author: '托马斯·科尔曼',\n    category: '科技',\n    summary: '深入剖析算法设计与分析的核心思想。',\n  },\n  {\n    id: 6,\n    title: '人类简史',\n    author: '尤瓦尔·赫拉利',\n    category: '历史',\n    summary: '从认知革命到科学革命的宏大人类叙事。',\n  },\n  {\n    id: 7,\n    title: '万历十五年',\n    author: '黄仁宇',\n    category: '历史',\n    summary: '以关键一年透视明代政治与社会结构。',\n  },\n  {\n    id: 8,\n    title: '史记',\n    author: '司马迁',\n    category: '历史',\n    summary: '纪传体通史巨著，记录千年兴衰人物。',\n  },\n];\n"
