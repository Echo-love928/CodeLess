      "name" : "files.create",
      "arguments" : {
        "path" : "src/pages/TasksPage.vue",
        "content" : "<script setup lang=\"ts\">\nimport { computed, onMounted, ref } from 'vue';\nimport { loadTodos, saveTodos, createTodo } from '../data/todos';\nimport type { Todo } from '../data/todos';\n\nconst todos = ref<Todo[]>([]);\nconst newTitle = ref('');\n\nonMounted(() => {\n  todos.value = loadTodos();\n});\n\nconst remaining = computed(() => todos.value.filter((t) => !t.done).length);\n\nfunction persist(): void {\n  saveTodos(todos.value);\n}\n\nfunction addTodo(): void {\n  const title = newTitle.value.trim();\n  if (!title) return;\n  todos.value.push(createTodo(title, todos.value));\n  newTitle.value = '';\n  persist();\n}\n\nfunction toggle(todo: Todo): void {\n  todo.done = !todo.done;\n  persist();\n}\n\nfunction remove(todo: Todo): void {\n  todos.value = todos.value.filter((t) => t.id !== todo.id);\n  persist();\n}\n</script>\n\n<template>\n  <main data-ai-component=\"tasks-page\" class=\"tasks-page\">\n    <h1 class=\"page-title\">个人待办清单</h1>\n\n    <form class=\"add-form\" @submit.prevent=\"addTodo\">\n      <input\n        v-model=\"newTitle\"\n        class=\"task-input\"\n        type=\"text\"\n        placeholder=\"输入任务标题\"\n        data-testid=\"task-input\"\n      />\n      <button type=\"submit\" class=\"add-btn\" data-testid=\"add-btn\">添加</button>\n    </form>\n\n    <p class=\"counter\" data-testid=\"remaining-count\">未完成：{{ remaining }}</p>\n\n    <ul v-if=\"todos.length\" class=\"task-list\">\n      <li v-for=\"todo in todos\" :key=\"todo.id\" class=\"task-item\" :class=\"{ done: todo.done }\">\n        <label class=\"task-label\">\n          <input\n            type=\"checkbox\"\n            :checked=\"todo.done\"\n            :data-testid=\"'toggle-' + todo.id\"\n            @change=\"toggle(todo)\"\n          />\n          <span class=\"task-title\">{{ todo.title }}</span>\n        </label>\n        <button\n          type=\"button\"\n          class=\"delete-btn\"\n          :data-testid=\"'delete-' + todo.id\"\n          @click=\"remove(todo)\"\n        >\n          删除\n        </button>\n      </li>\n    </ul>\n    <p v-else class=\"empty\" data-testid=\"empty\">暂无任务</p>\n  </main>\n</template>\n\n<style scoped>\n.tasks-page {\n  max-width: 480px;\n  margin: 0 auto;\n  padding: 24px 16px;\n  font-family: system-ui, sans-serif;\n  color: #1f2937;\n}\n.page-title {\n  font-size: 24px;\n  margin: 0 0 16px;\n}\n.add-form {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 12px;\n}\n.task-input {\n  flex: 1;\n  padding: 8px 10px;\n  border: 1px solid #d1d5db;\n  border-radius: 6px;\n  font-size: 14px;\n}\n.add-btn {\n  padding: 8px 16px;\n  border: none;\n  border-radius: 6px;\n  background: #2563eb;\n  color: #fff;\n  font-size: 14px;\n  cursor: pointer;\n}\n.counter {\n  font-size: 14px;\n  color: #4b5563;\n  margin: 0 0 12px;\n}\n.task-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n.task-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 10px 12px;\n  border: 1px solid #e5e7eb;\n  border-radius: 6px;\n  margin-bottom: 8px;\n}\n.task-label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex: 1;\n  cursor: pointer;\n}\n.task-item.done .task-title {\n  text-decoration: line-through;\n  color: #9ca3af;\n}\n.delete-btn {\n  padding: 4px 10px;\n  border: 1px solid #ef4444;\n  border-radius: 6px;\n  background: #fff;\n  color: #ef4444;\n  font-size: 13px;\n  cursor: pointer;\n}\n.empty {\n  color: #9ca3af;\n  font-size: 14px;\n}\n</style>\n"
      }
