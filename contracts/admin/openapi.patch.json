    "/api/v0/admin/audit": {
      "get": {
        "operationId": "listAdminAudit",
        "summary": "List administrator audit entries",
        "description": "Ordered by requestedAt DESC, id DESC instead of createdAt. Ordered by createdAt DESC, id DESC. Unknown, repeated or empty query parameters are rejected with 400 INVALID_REQUEST.",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "0-based page index.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "TASK_CANCEL"
              ]
            }
          },
          {
            "name": "actorId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "targetId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "outcome",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CANCELLED",
                "ALREADY_TERMINAL",
                "NOT_FOUND",
                "FAILED",
                "UNKNOWN"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit page",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./admin/admin.schema.json#/$defs/AuditPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "description": "Audit ledger unavailable or unreadable (ADMIN_AUDIT_UNAVAILABLE); nothing was changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/admin/metrics": {
      "get": {
        "operationId": "getAdminMetrics",
        "summary": "Generation, deployment, repair and token metrics",
        "description": "Each population is filtered by its own createdAt in [from, to). Generation and deployment rates never share a denominator. A rate with denominator 0 is null, never 0. Exact token totals are null unless every call has known usage. Definitions: contracts/admin/README.md.",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Inclusive lower bound on createdAt (RFC 3339 with offset).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Exclusive upper bound on createdAt; must be after from.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Metrics for the window",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./admin/admin.schema.json#/$defs/Metrics"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v0/admin/tasks/{taskId}/cancel": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TaskId"
        }
      ],
      "post": {
        "operationId": "cancelTaskAsAdministrator",
        "summary": "Cancel a nonterminal task (audited)",
        "description": "The only administrator mutation. CSRF-protected; ADMIN role only. The audit intent is written before the task row is touched (503 if it cannot be); the outcome is recorded after commit. A nonterminal task becomes FAILED/CANCELLED with the event \"Task cancelled by administrator\"; an already terminal task is unchanged (ALREADY_TERMINAL). Unknown tasks return 404 and are audited as NOT_FOUND. Rejected (400/401/403) requests are not audited.",
        "tags": [
          "admin"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./admin/admin.schema.json#/$defs/CancelRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative task and its audit entry",
            "headers": {
              "Cache-Control": {
                "description": "Always no-store.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./admin/admin.schema.json#/$defs/CancelResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "description": "Audit ledger unavailable or unreadable (ADMIN_AUDIT_UNAVAILABLE); nothing was changed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          }
        }
      }
    }
  }
