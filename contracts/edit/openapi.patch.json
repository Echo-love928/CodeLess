{
  "paths": {
    "/api/v0/applications/{applicationId}/edits": {
      "parameters": [
        {
          "name": "applicationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "createConversationEdit",
        "summary": "Create an edit against the current immutable available version",
        "tags": [
          "tasks"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./edit/edit.schema.json#/$defs/request"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Edit task accepted or matching replay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./edit/edit.schema.json#/$defs/response"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "429": {
            "description": "APPLICATION_TASK_LIMIT or USER_TASK_LIMIT: active QUEUED + RUNNING limit reached; no task/event inserted. A matching idempotent replay returns the original task without another admission.",
            "x-codeless-capacity-codes": [
              "APPLICATION_TASK_LIMIT",
              "USER_TASK_LIMIT"
            ],
            "headers": {
              "Retry-After": {
                "description": "For the listed capacity codes only: 1 second. Optional for other 503 errors. Preserve the same Idempotency-Key and payload when retrying; retry does not guarantee admission.",
                "schema": {
                  "type": "string",
                  "const": "1"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./schemas/v0/error.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "enum": [
                            "APPLICATION_TASK_LIMIT",
                            "USER_TASK_LIMIT"
                          ]
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "APPLICATION_TASK_LIMIT": {
                    "value": {
                      "code": "APPLICATION_TASK_LIMIT",
                      "message": "Task admission limit reached",
                      "timestamp": "2026-10-28T00:00:00Z",
                      "path": "/api/v0/applications/{applicationId}/edits",
                      "traceId": "capacity-example",
                      "details": {}
                    }
                  },
                  "USER_TASK_LIMIT": {
                    "value": {
                      "code": "USER_TASK_LIMIT",
                      "message": "Task admission limit reached",
                      "timestamp": "2026-10-28T00:00:00Z",
                      "path": "/api/v0/applications/{applicationId}/edits",
                      "traceId": "capacity-example",
                      "details": {}
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "TASK_QUEUE_FULL (global QUEUED limit) or TASK_ADMISSION_BUSY (admission lock timeout, at most 1 second): no task/event inserted. Existing snapshot/storage failures also use 503 and retain their error codes; they do not carry the capacity retry header.",
            "x-codeless-capacity-codes": [
              "TASK_QUEUE_FULL",
              "TASK_ADMISSION_BUSY"
            ],
            "headers": {
              "Retry-After": {
                "description": "For the listed capacity codes only: 1 second. Optional for other 503 errors. Preserve the same Idempotency-Key and payload when retrying; retry does not guarantee admission.",
                "schema": {
                  "type": "string",
                  "const": "1"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                },
                "examples": {
                  "TASK_QUEUE_FULL": {
                    "value": {
                      "code": "TASK_QUEUE_FULL",
                      "message": "Task admission limit reached",
                      "timestamp": "2026-10-28T00:00:00Z",
                      "path": "/api/v0/applications/{applicationId}/edits",
                      "traceId": "capacity-example",
                      "details": {}
                    }
                  },
                  "TASK_ADMISSION_BUSY": {
                    "value": {
                      "code": "TASK_ADMISSION_BUSY",
                      "message": "Task admission limit reached",
                      "timestamp": "2026-10-28T00:00:00Z",
                      "path": "/api/v0/applications/{applicationId}/edits",
                      "traceId": "capacity-example",
                      "details": {}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/tasks/{taskId}/edit": {
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getConversationEdit",
        "summary": "Read owned edit task and retained base/source association",
        "tags": [
          "tasks"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Edit task and base association",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./edit/edit.schema.json#/$defs/response"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "503": {
            "description": "Request rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          }
        }
      }
    }
  }
}
