{
  "openapi": "3.1.0",
  "info": {
    "title": "CodeLess API",
    "version": "0.0.0",
    "description": "CodeLess platform API. Authentication uses a host-only session cookie and CSRF tokens. Task state is derived from real tool results; publication requires an authenticated user and a verified immutable version.",
    "license": { "name": "Proprietary", "url": "https://codeless.dev/license" }
  },
  "servers": [{ "url": "/", "description": "Same-origin platform gateway" }],
  "security": [{ "sessionCookie": [] }],
  "tags": [
    { "name": "system", "description": "Service health" },
    { "name": "auth", "description": "Platform session authentication" },
    { "name": "applications", "description": "Vue application metadata" },
    { "name": "tasks", "description": "Generation lifecycle and events" },
    { "name": "builds", "description": "Real runner build results" },
    { "name": "versions", "description": "Immutable source versions" },
    { "name": "preview", "description": "Short-lived isolated verified-version previews" },
    { "name": "publications", "description": "User-triggered publications" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Return API liveness",
        "tags": ["system"],
        "security": [],
        "responses": {
          "200": {
            "description": "API is alive",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" }, "example": { "status": "UP", "service": "codeless-api" } } }
          },
          "429": { "description": "Rate limited", "content": { "application/json": { "schema": { "$ref": "./schemas/v0/error.schema.json" } } } }
        }
      }
    },
    "/api/v0/auth/csrf": {
      "get": {
        "operationId": "getCsrfToken",
        "summary": "Start a session and obtain its CSRF token",
        "description": "Creates a host-only HttpOnly JSESSIONID cookie if needed. Send the returned token in X-CSRF-Token for login and other unsafe requests.",
        "tags": ["auth"],
        "security": [],
        "responses": {
          "200": { "description": "CSRF token for this session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CsrfToken" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v0/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Log in with a platform account",
        "description": "Requires the session cookie created by GET /api/v0/auth/csrf and its X-CSRF-Token header. On success, rotates the session ID.",
        "tags": ["auth"],
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": {
          "200": { "description": "Authenticated user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthUser" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "description": "Invalid credentials (INVALID_CREDENTIALS)", "content": { "application/json": { "schema": { "$ref": "./schemas/v0/error.schema.json" } } } },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/v0/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "Restore the current authenticated user",
        "tags": ["auth"],
        "responses": {
          "200": { "description": "Authenticated user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthUser" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/api/v0/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Invalidate the current session",
        "tags": ["auth"],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "responses": {
          "204": { "description": "Session invalidated" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v0/admin/session": {
      "get": {
        "operationId": "getAdminSession",
        "summary": "Check the current administrator session",
        "description": "Requires the ADMIN role; an authenticated USER receives 403.",
        "tags": ["auth"],
        "responses": {
          "200": { "description": "Authenticated administrator", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthUser" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v0/applications": {
      "get": {
        "operationId": "listApplications",
        "summary": "List the current user's applications",
        "description": "Owner-scoped results use stable order by createdAt descending, then id descending.",
        "tags": ["applications"],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Owner-scoped page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplicationPage" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "post": {
        "operationId": "createApplication",
        "summary": "Create a Vue application shell",
        "tags": ["applications"],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateApplicationRequest" }, "example": { "name": "社团活动页", "dataMode": "MOCK" } } }
        },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "./schemas/v0/application.schema.json" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v0/applications/{applicationId}": {
      "parameters": [{ "$ref": "#/components/parameters/ApplicationId" }],
      "get": {
        "operationId": "getApplication",
        "summary": "Get an application",
        "tags": ["applications"],
        "responses": {
          "200": { "description": "Found", "content": { "application/json": { "schema": { "$ref": "./schemas/v0/application.schema.json" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "operationId": "renameApplication",
        "summary": "Rename an application owned by the current user",
        "tags": ["applications"],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RenameApplicationRequest" } } } },
        "responses": {
          "200": { "description": "Renamed", "content": { "application/json": { "schema": { "$ref": "./schemas/v0/application.schema.json" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v0/tasks": {
      "post": {
        "operationId": "createTask",
        "summary": "Start a generation task",
        "description": "New tasks start in PLAN. Idempotency-Key is scoped to one application: the same key and normalized prompt returns the original task (including its current state); a different prompt returns 409. Queue, leases and deadlines stay internal.",
        "tags": ["tasks"],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }, { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._:-]+$" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateTaskRequest" }, "example": { "applicationId": "11111111-1111-4111-8111-111111111111", "prompt": "生成活动页" } } }
        },
        "responses": {
          "202": { "description": "New task or matching idempotent replay", "content": { "application/json": { "schema": { "$ref": "./schemas/v0/task.schema.json" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {"description":"IDEMPOTENCY_CONFLICT","content":{"application/json":{"schema":{"allOf":[{"$ref":"./schemas/v0/error.schema.json"},{"type":"object","properties":{"code":{"const":"IDEMPOTENCY_CONFLICT"}}}]}}}}
        }
      }
    },
    "/api/v0/tasks/{taskId}": {
      "parameters": [{ "$ref": "#/components/parameters/TaskId" }],
      "get": {
        "operationId": "getTask",
        "summary": "Get task state",
        "tags": ["tasks"],
        "responses": {
          "200": { "description": "Found", "content": { "application/json": { "schema": { "$ref": "./schemas/v0/task.schema.json" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v0/tasks/{taskId}/events": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TaskId"
        }
      ],
      "get": {
        "operationId": "listTaskEvents",
        "summary": "Replay sanitized task events as JSON pages or resumable SSE",
        "tags": [
          "tasks"
        ],
        "description": "Authenticate every connection with the session cookie and check task ownership. Accept application/json (default) for bounded history or text/event-stream for task-event frames. SSE id is the task-local sequence, never the event resource UUID. Replays are strictly increasing and exclusive of the cursor. Last-Event-ID takes precedence over afterEventId only for SSE. Historical messages are fixed allowlisted summaries. READY/FAILED drains outstanding events then closes; EOF is not proof of task success. Query the task status, stop reconnecting at terminal state, and deduplicate by sequence. Unknown frames must not crash the client.",
        "parameters": [
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "description": "SSE-only exclusive cursor. Canonical decimal int32 in [0,2147483647], default 0. A present header overrides afterEventId, including an invalid header; it is not used for JSON pages.",
            "schema": {
              "$ref": "#/paths/~1api~1v0~1tasks~1{taskId}~1events/get/parameters/1/schema"
            },
            "example": "3"
          },
          {
            "name": "afterEventId",
            "in": "query",
            "required": false,
            "description": "Exclusive task-local sequence cursor for JSON pages and SSE without Last-Event-ID. Canonical decimal int32, default 0. Empty, signed, padded, whitespace, UUID and overflow values fail with INVALID_EVENT_ID.",
            "schema": {
              "type": "string",
              "default": "0",
              "pattern": "^(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
            },
            "example": "3"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "JSON page size only; SSE backlog is always capped at 1000. Drain JSON pages by advancing afterEventId to the last applied sequence until a short or empty page, then subscribe at that cursor.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "JSON history page or SSE stream. Task-local integer sequence is distinct from the UUID data.id. A terminal task at its head returns an empty SSE body and closes.",
            "headers": {
              "Cache-Control": {
                "description": "SSE response disables caching.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Accel-Buffering": {
                "description": "SSE response requests no nginx buffering; deployment must also bound writes and sockets.",
                "schema": {
                  "type": "string",
                  "const": "no"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "$ref": "./schemas/v0/event.schema.json"
                  }
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "taskEvent": {
                    "summary": "Persisted event followed by a non-business heartbeat",
                    "value": "id:1\nevent:task-event\ndata:{\"id\":\"33333333-3333-4333-8333-333333333333\",\"taskId\":\"22222222-2222-4222-8222-222222222222\",\"sequence\":1,\"type\":\"STAGE_STARTED\",\"stage\":\"PLAN\",\"message\":\"Stage started: PLAN\",\"occurredAt\":\"2026-09-30T00:00:00Z\"}\n\n:heartbeat\nretry:1000\n\n"
                  },
                  "streamError": {
                    "summary": "Post-header error has no id and closes the connection",
                    "value": "event:stream-error\ndata:{\"code\":\"EVENT_BACKLOG_EXCEEDED\"}\n\n"
                  },
                  "terminalAtHead": {
                    "summary": "Terminal task with no remaining events",
                    "value": ""
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid cursor (INVALID_EVENT_ID), page size (INVALID_EVENT_LIMIT), or typed scalar/task UUID (INVALID_REQUEST). Pre-stream errors are JSON even when Accept is text/event-stream.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./schemas/v0/error.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "enum": [
                            "INVALID_EVENT_ID",
                            "INVALID_EVENT_LIMIT",
                            "INVALID_REQUEST"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "EVENT_CURSOR_AHEAD: cursor exceeds this task's durable head. EVENT_BACKLOG_EXCEEDED: initial SSE backlog exceeds 1000; JSON page and then reconnect without dropping records.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./schemas/v0/error.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "enum": [
                            "EVENT_CURSOR_AHEAD",
                            "EVENT_BACKLOG_EXCEEDED"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR: inconsistent durable history, unknown stored state or other failure before streaming. No successful task state is implied.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./schemas/v0/error.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "const": "INTERNAL_ERROR"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "EVENT_STREAM_CAPACITY: at most 64 active SSE connections per API instance.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./schemas/v0/error.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "const": "EVENT_STREAM_CAPACITY"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "x-sse-protocol": {
          "businessEvent": "task-event",
          "businessDataSchema": {
            "$ref": "./schemas/v0/event.schema.json"
          },
          "transportId": "sequence",
          "heartbeat": {
            "comment": "heartbeat",
            "retryMilliseconds": 1000,
            "intervalMilliseconds": 15000,
            "persisted": false
          },
          "postHeaderError": {
            "event": "stream-error",
            "id": false,
            "codes": [
              "EVENT_BACKLOG_EXCEEDED",
              "NOT_FOUND",
              "EVENT_STREAM_FAILED"
            ]
          },
          "pollMilliseconds": 500,
          "connectionLifetimeMilliseconds": 60000,
          "maxBacklog": 1000,
          "maxConnectionsPerInstance": 64
        }
      }
    },
    "/api/v0/tasks/{taskId}/cancel": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TaskId"
        }
      ],
      "post": {
        "operationId": "cancelTask",
        "summary": "Cancel an owned task",
        "tags": [
          "tasks"
        ],
        "description": "CSRF-protected and idempotent. An active task becomes FAILED/CANCELLED; a task already READY or FAILED remains unchanged. Task ownership is required even for administrators.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "200": {
            "description": "Current authoritative task, including already-terminal tasks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/task.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v0/tasks/{taskId}/diagnostics": {
      "parameters": [
        {
          "$ref": "#/components/parameters/TaskId"
        }
      ],
      "get": {
        "operationId": "getTaskDiagnostics",
        "summary": "Read owned structured task metadata",
        "tags": [
          "tasks"
        ],
        "description": "Read-only owner-scoped snapshot. available=false means no file producer result, distinct from available=true with an empty change list. Only approved source paths and digests are returned; raw source, diffs, tool messages and log URLs are excluded. Builds reflect persisted QUEUED/RUNNING/SUCCEEDED/FAILED records and do not imply the task is READY. Maximum 40 file changes and 100 build records. Overflow or corrupt persisted metadata fails instead of silently truncating. Producers write internally with an active lease and expected revision; no public write endpoint.",
        "responses": {
          "200": {
            "description": "Structured metadata; task state remains authoritative",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/task-diagnostics.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./schemas/v0/error.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "const": "INTERNAL_ERROR"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/builds/{buildId}": {
      "parameters": [{ "$ref": "#/components/parameters/BuildId" }],
      "get": {
        "operationId": "getBuild",
        "summary": "Get a real build result",
        "tags": ["builds"],
        "responses": {
          "200": { "description": "Found", "content": { "application/json": { "schema": { "$ref": "./schemas/v0/build.schema.json" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v0/versions/{versionId}": {
      "parameters": [{ "$ref": "#/components/parameters/VersionId" }],
      "get": {
        "operationId": "getVersion",
        "summary": "Get an immutable source version",
        "tags": ["versions"],
        "responses": {
          "200": { "description": "Found", "content": { "application/json": { "schema": { "$ref": "./schemas/v0/version.schema.json" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v0/applications/{applicationId}/versions/{versionId}/preview-credentials": {
      "parameters": [
        {
          "name": "applicationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        },
        {
          "name": "versionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "createPreviewCredential",
        "summary": "Issue a two-minute credential for a registered verified version",
        "description": "Requires host-only platform session, CSRF and ownership. Exact committed build/source/artifact must already be registered by the trusted resident gateway. Response is no-store; url is a temporary bearer capability and must not be logged or persisted.",
        "tags": [
          "preview"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped credential, no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/preview-credential.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Unauthenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "CSRF token rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Not owned or resource mismatch",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "Version/build not verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "503": {
            "description": "Gateway unavailable, unregistered version, or invalid deployment configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/publications": {
      "post": {
        "operationId": "createPublication",
        "summary": "Publish a verified immutable version",
        "description": "Must be explicitly requested by the authenticated owner. The server rejects unverified versions.",
        "tags": ["publications"],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatePublicationRequest" }, "example": { "applicationId": "11111111-1111-4111-8111-111111111111", "versionId": "55555555-5555-4555-8555-555555555555" } } }
        },
        "responses": {
