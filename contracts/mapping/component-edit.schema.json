{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeless.dev/contracts/mapping/component-edit.schema.json",
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionId",
        "sourceDigest",
        "componentId"
      ],
      "properties": {
        "versionId": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "minLength": 71,
          "maxLength": 71
        },
        "componentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectable",
        "shared",
        "notice",
        "versionId",
        "sourceDigest",
        "componentId",
        "sourceFile",
        "fileDigest",
        "scope"
      ],
      "properties": {
        "versionId": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "minLength": 71,
          "maxLength": 71
        },
        "componentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "minLength": 1,
          "maxLength": 64
        },
        "selectable": {
          "const": true
        },
        "shared": {
          "const": true
        },
        "notice": {
          "type": "string"
        },
        "sourceFile": {
          "type": "string",
          "pattern": "^src/(pages|components)/[A-Za-z][A-Za-z0-9_-]*\\.vue$",
          "maxLength": 240
        },
        "fileDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "minLength": 71,
          "maxLength": 71
        },
        "scope": {
          "const": "SOURCE_FILE"
        }
      }
    },
    "denied": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selectable",
        "reason"
      ],
      "properties": {
        "selectable": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseVersionId",
        "prompt",
        "selection"
      ],
      "properties": {
        "baseVersionId": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "pattern": "\\S"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "versionId",
            "sourceDigest",
            "componentId"
          ],
          "properties": {
            "versionId": {
              "type": "string",
              "format": "uuid",
              "minLength": 36,
              "maxLength": 36
            },
            "sourceDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "minLength": 71,
              "maxLength": 71
            },
            "componentId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "baseVersionId",
        "source"
      ],
      "properties": {
        "task": {
          "$ref": "../schemas/v0/task.schema.json"
        },
        "baseVersionId": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "componentId",
            "versionId",
            "sourceDigest",
            "sourceFile"
          ],
          "properties": {
            "type": {
              "const": "COMPONENT"
            },
            "versionId": {
              "type": "string",
              "format": "uuid",
              "minLength": 36,
              "maxLength": 36
            },
            "sourceDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "minLength": 71,
              "maxLength": 71
            },
            "componentId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
              "minLength": 1,
              "maxLength": 64
            },
            "sourceFile": {
              "type": "string",
              "pattern": "^src/(pages|components)/[A-Za-z][A-Za-z0-9_-]*\\.vue$",
              "maxLength": 240
            }
          }
        }
      }
    }
  }
}
