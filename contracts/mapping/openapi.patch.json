{
  "paths": {
    "/api/v0/versions/{versionId}/component-mapping": {
      "parameters": [
        {
          "name": "versionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getComponentMapping",
        "summary": "Read the immutable version component sidecar; missing legacy mappings fail closed",
        "tags": [
          "versions"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Frozen component mapping",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./mapping/manifest.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "503": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/versions/{versionId}/component-selection": {
      "parameters": [
        {
          "name": "versionId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "resolveComponentSelection",
        "summary": "Resolve an untrusted ID to shared source scope",
        "tags": [
          "versions"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "versionId",
                  "sourceDigest",
                  "componentId"
                ],
                "properties": {
                  "versionId": {
                    "type": "string",
                    "format": "uuid",
                    "minLength": 36,
                    "maxLength": 36
                  },
                  "sourceDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "minLength": 71,
                    "maxLength": 71
                  },
                  "componentId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                    "minLength": 1,
                    "maxLength": 64
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selectable source or explicit disabled reason",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "selectable",
                        "shared",
                        "notice",
                        "versionId",
                        "sourceDigest",
                        "componentId",
                        "sourceFile",
                        "fileDigest",
                        "scope"
                      ],
                      "properties": {
                        "versionId": {
                          "type": "string",
                          "format": "uuid",
                          "minLength": 36,
                          "maxLength": 36
                        },
                        "sourceDigest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$",
                          "minLength": 71,
                          "maxLength": 71
                        },
                        "componentId": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "selectable": {
                          "const": true
                        },
                        "shared": {
                          "const": true
                        },
                        "notice": {
                          "type": "string"
                        },
                        "sourceFile": {
                          "type": "string",
                          "pattern": "^src/(pages|components)/[A-Za-z][A-Za-z0-9_-]*\\.vue$",
                          "maxLength": 240
                        },
                        "fileDigest": {
                          "type": "string",
                          "pattern": "^sha256:[a-f0-9]{64}$",
                          "minLength": 71,
                          "maxLength": 71
                        },
                        "scope": {
                          "const": "SOURCE_FILE"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "selectable",
                        "reason"
                      ],
                      "properties": {
                        "selectable": {
                          "const": false
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "503": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v0/applications/{applicationId}/component-edits": {
      "parameters": [
        {
          "name": "applicationId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "createComponentEdit",
        "summary": "Create a new draft task with an owner/base lock and server-resolved component source",
        "tags": [
          "versions"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/CsrfToken"
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "./mapping/component-edit.schema.json#/$defs/request"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Component modification queued; never publishes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./mapping/component-edit.schema.json#/$defs/response"
                }
              }
            }
          },
          "400": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "403": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "Request rejected; no task or version mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                }
              }
            }
          },
          "429": {
            "description": "APPLICATION_TASK_LIMIT or USER_TASK_LIMIT: active QUEUED + RUNNING limit reached; no task/event inserted. A matching idempotent replay returns the original task without another admission.",
            "x-codeless-capacity-codes": [
              "APPLICATION_TASK_LIMIT",
              "USER_TASK_LIMIT"
            ],
            "headers": {
              "Retry-After": {
                "description": "For the listed capacity codes only: 1 second. Optional for other 503 errors. Preserve the same Idempotency-Key and payload when retrying; retry does not guarantee admission.",
                "schema": {
                  "type": "string",
                  "const": "1"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "./schemas/v0/error.schema.json"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "enum": [
                            "APPLICATION_TASK_LIMIT",
                            "USER_TASK_LIMIT"
                          ]
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "APPLICATION_TASK_LIMIT": {
                    "value": {
                      "code": "APPLICATION_TASK_LIMIT",
                      "message": "Task admission limit reached",
                      "timestamp": "2026-10-28T00:00:00Z",
                      "path": "/api/v0/applications/{applicationId}/component-edits",
                      "traceId": "capacity-example",
                      "details": {}
                    }
                  },
                  "USER_TASK_LIMIT": {
                    "value": {
                      "code": "USER_TASK_LIMIT",
                      "message": "Task admission limit reached",
                      "timestamp": "2026-10-28T00:00:00Z",
                      "path": "/api/v0/applications/{applicationId}/component-edits",
                      "traceId": "capacity-example",
                      "details": {}
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "TASK_QUEUE_FULL (global QUEUED limit) or TASK_ADMISSION_BUSY (admission lock timeout, at most 1 second): no task/event inserted. Existing snapshot/storage failures also use 503 and retain their error codes; they do not carry the capacity retry header.",
            "x-codeless-capacity-codes": [
              "TASK_QUEUE_FULL",
              "TASK_ADMISSION_BUSY"
            ],
            "headers": {
              "Retry-After": {
                "description": "For the listed capacity codes only: 1 second. Optional for other 503 errors. Preserve the same Idempotency-Key and payload when retrying; retry does not guarantee admission.",
                "schema": {
                  "type": "string",
                  "const": "1"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./schemas/v0/error.schema.json"
                },
                "examples": {
                  "TASK_QUEUE_FULL": {
                    "value": {
                      "code": "TASK_QUEUE_FULL",
                      "message": "Task admission limit reached",
                      "timestamp": "2026-10-28T00:00:00Z",
                      "path": "/api/v0/applications/{applicationId}/component-edits",
                      "traceId": "capacity-example",
                      "details": {}
                    }
                  },
                  "TASK_ADMISSION_BUSY": {
                    "value": {
                      "code": "TASK_ADMISSION_BUSY",
                      "message": "Task admission limit reached",
                      "timestamp": "2026-10-28T00:00:00Z",
                      "path": "/api/v0/applications/{applicationId}/component-edits",
                      "traceId": "capacity-example",
                      "details": {}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
