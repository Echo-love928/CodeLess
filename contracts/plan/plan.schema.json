{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeless.dev/contracts/plan/v1",
  "title": "Controlled Vue plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "template", "dataMode", "pages", "components", "files", "acceptance", "capabilities"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "template": {"type": "string", "const": "VUE"},
    "dataMode": {"type": "string", "enum": ["STATIC", "MOCK", "LOCAL_STORAGE"]},
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["route", "file", "title", "purpose"],
        "properties": {
          "route": {"type": "string", "enum": ["/", "/tasks", "/catalog"]},
          "file": {"type": "string", "enum": ["src/pages/HomePage.vue", "src/pages/TasksPage.vue", "src/pages/CatalogPage.vue"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 120},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "components": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "file", "purpose"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,80}$"},
          "file": {"type": "string", "pattern": "^src/components/[A-Za-z][A-Za-z0-9_-]*\\.vue$", "maxLength": 240},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "purpose"],
        "properties": {
          "path": {"type": "string", "pattern": "^(src/(pages|components)/[A-Za-z][A-Za-z0-9_-]*\\.vue|src/data/[A-Za-z][A-Za-z0-9_-]*\\.ts)$", "maxLength": 240},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "acceptance": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "route", "action", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^A[1-9][0-9]?$"},
          "route": {"type": "string", "enum": ["/", "/tasks", "/catalog"]},
          "action": {"type": "string", "minLength": 1, "maxLength": 500},
          "expected": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "payments", "externalServices", "dependencies"],
      "properties": {
        "backend": {"type": "boolean", "const": false},
        "payments": {"type": "boolean", "const": false},
        "externalServices": {"type": "array", "maxItems": 0},
        "dependencies": {"type": "array", "maxItems": 0}
      }
    }
  }
}
