{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreviewCredential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "applicationId",
    "versionId",
    "url",
    "expiresAt"
  ],
  "properties": {
    "applicationId": {
      "type": "string",
      "format": "uuid"
    },
    "versionId": {
      "type": "string",
      "format": "uuid"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://v[a-f0-9]{32}\\.[a-z0-9.-]+(:[0-9]{1,5})?/__preview/start\\?credential=[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
