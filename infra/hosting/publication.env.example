# Operator-owned host settings. Replace every example before enabling.
# Keep this file outside generated applications; never commit credentials.
CODELESS_PUBLICATION_ENABLED=false
CODELESS_NODE_EXECUTABLE=/usr/local/bin/node
CODELESS_PUBLICATION_GATEWAY_ENTRY=/srv/codeless/repository/services/runner/src/publish/gateway-cli.mjs
CODELESS_HOSTING_ROOT=/srv/codeless/publication/sites
CODELESS_PUBLICATION_ORIGIN=https://sites.example-public.com
CODELESS_PLATFORM_ORIGIN=https://app.example-platform.com
CODELESS_PREVIEW_ORIGIN=https://preview.example-preview.com
CODELESS_HOSTING_CONFIG=/srv/codeless/publication/nginx.conf
CODELESS_PLATFORM_CONFIG=/srv/codeless/platform/codeless-publication-config.json
CODELESS_TLS_CERT=/etc/codeless/publication/server.pem
CODELESS_TLS_KEY=/etc/codeless/publication/server.key
CODELESS_PUBLIC_BIND=0.0.0.0:443
