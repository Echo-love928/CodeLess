[Unit]
Description=Reap expired owned CodeLess worker containers
After=docker.service
[Service]
Type=oneshot
User=codeless-worker
Group=codeless-ipc
SupplementaryGroups=docker
ExecStart=/usr/bin/python3 /opt/codeless/ops/reap.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
TimeoutStartSec=30
