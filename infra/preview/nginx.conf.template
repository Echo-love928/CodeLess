# Rendered once from validated, trusted deployment origins/ports by render.mjs.
# Private service keys never enter ingress or generated-code containers.
# These resolved addresses belong to one resident gateway. A stopped gateway must
# not quarantine every address for the default 10s after it has restarted.
upstream codeless_preview_gateway {
    server host.docker.internal:${CODELESS_PREVIEW_GATEWAY_PORT} max_fails=0;
}
server {
    server_tokens off;
    listen 8443 ssl default_server;
    server_name _;
    ssl_certificate /certs/server.pem;
    ssl_certificate_key /certs/server.key;
    access_log off;
    return 404;
}
server {
    server_tokens off;
    listen 8443 ssl;
    server_name ${CODELESS_PLATFORM_HOST};
    ssl_certificate /certs/server.pem;
    ssl_certificate_key /certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src https://*.${CODELESS_PREVIEW_AUTHORITY}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    root /usr/share/nginx/html;
    location ^~ /internal/ { return 404; }
    location ^~ /api/v0/ {
        proxy_pass http://host.docker.internal:${CODELESS_API_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Codeless-Preview-Registry-Key "";
        proxy_set_header X-Codeless-Artifact-Token "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-For "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }
    location = /version.json { expires -1; try_files $uri =404; }
    location = /api { default_type application/json; return 404 '{"code":"NOT_FOUND"}'; }
    location ^~ /api/ { default_type application/json; return 404 '{"code":"NOT_FOUND"}'; }
    location = /index.html {
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src https://*.${CODELESS_PREVIEW_AUTHORITY}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location / { try_files $uri /index.html; }
}
server {
    server_tokens off;
    listen 8443 ssl;
    server_name *.${CODELESS_PREVIEW_HOST};
    ssl_certificate /certs/server.pem;
    ssl_certificate_key /certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off; # Bootstrap query contains a short-lived bearer credential.
    error_log /dev/null; # Upstream errors otherwise log the full credential-bearing request URI.
    location / {
        proxy_pass http://codeless_preview_gateway;
        proxy_set_header Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Codeless-Preview-Registry-Key "";
        proxy_set_header X-Codeless-Artifact-Token "";
        proxy_cache off;
        proxy_buffering off;
        proxy_read_timeout 5s;
    }
}
