# Rendered once from validated, trusted deployment origins/ports by render.mjs.
# Private service keys never enter ingress or generated-code containers.
server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_certificate /certs/server.pem;
    ssl_certificate_key /certs/server.key;
    access_log off;
    return 404;
}
server {
    listen 8443 ssl;
    server_name ${CODELESS_PLATFORM_HOST};
    ssl_certificate /certs/server.pem;
    ssl_certificate_key /certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    root /usr/share/nginx/html;
    location ^~ /internal/ { return 404; }
    location ^~ /api/v0/ {
        proxy_pass http://host.docker.internal:${CODELESS_API_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Codeless-Preview-Registry-Key "";
        proxy_set_header X-Codeless-Artifact-Token "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-For "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
    }
    location / { try_files $uri /index.html; }
}
server {
    listen 8443 ssl;
    server_name *.${CODELESS_PREVIEW_HOST};
    ssl_certificate /certs/server.pem;
    ssl_certificate_key /certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off; # Bootstrap query contains a short-lived bearer credential.
    location / {
        proxy_pass http://host.docker.internal:${CODELESS_PREVIEW_GATEWAY_PORT};
        proxy_set_header Host $http_host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Codeless-Preview-Registry-Key "";
        proxy_set_header X-Codeless-Artifact-Token "";
        proxy_cache off;
        proxy_buffering off;
        proxy_read_timeout 5s;
    }
}
