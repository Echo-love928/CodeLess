[Unit]
Description=CodeLess trusted resident preview registry
After=network.target codeless-api.service

[Service]
Type=simple
User=codeless
Group=codeless
WorkingDirectory=/opt/codeless/current
EnvironmentFile=/etc/codeless/preview.env
ExecStart=/usr/bin/node services/runner/src/preview/main.mjs
Restart=on-failure
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
